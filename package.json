{
  "name": "life2film-landing",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler pages deploy dist --project-name=life2film-site --branch=production",
    "test": "vitest run",
    "check": "astro check && vitest run",
    "wasm": "cp node_modules/life2film-engine/va_wasm.js node_modules/life2film-engine/va_wasm_bg.wasm public/wasm/"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@mediabunny/mp3-encoder": "^1.54.0",
    "astro": "^5.0.0",
    "mediabunny": "^1.54.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "life2film-engine": "^0.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
