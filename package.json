    "astro": "^6.4.8",
    "mediabunny": "^1.54.0",
    "superduper-site-kit": "git+file:///Users/rustam/startups/shared/superduper-site-kit",
    "superduper-tools": "git+file:///Users/rustam/startups/shared/superduper-tools"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource/inter": "5.3.0",
