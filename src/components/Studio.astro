---
import { useStudio } from '../studio-i18n';
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = useStudio(lang);

const DMG = 'https://github.com/fortunto2/life2film-landing/releases/latest/download/Life2FilmStudio.dmg';
const RELEASES = 'https://github.com/fortunto2/life2film-landing/releases';

const steps = [
  { t: s('d1t'), d: s('d1d') },
  { t: s('d2t'), d: s('d2d') },
  { t: s('d3t'), d: s('d3d') },
];

const feats = [1, 2, 3, 4, 5, 6].map((i) => ({ t: s(`f${i}t`), d: s(`f${i}d`) }));
const MCP = 'claude mcp add studio -- "/Applications/Life2Film Studio.app/Contents/MacOS/studio-cli" mcp';
---

<main>
  <section class="hero">
    <div class="wrap">
      <img class="appicon" src="/img/studio-icon.png" alt="" width="96" height="96" />
      <span class="badge beta">{s('badge')}</span>
      <h1>{s('title')}</h1>
      <p class="lede">{s('lede')}</p>

      <div class="cta">
        {/* Цель. Общий снипет ловит data-sda-event сам — на сайте ни строки кода.
            Имена событий одинаковы на всех наших сайтах, иначе панель их не сложит:
            binary_downloaded — прямой файл, app_store_opened — ссылка в магазин. */}
        <a class="btn" href={DMG}
           data-sda-event="binary_downloaded" data-sda-placement="studio-hero">{s('ctaDownload')}</a>
        <a class="btn-ghost" href={RELEASES}>{s('ctaReleases')}</a>
      </div>
      <p class="muted small">{s('ctaNote')}</p>

      <figure class="shot">
        <img src="/img/studio.jpg" alt={s('shotCaption')} width="2000" height="1054" loading="lazy" decoding="async" />
        <figcaption>{s('shotCaption')}</figcaption>
      </figure>
    </div>
  </section>

  <section>
    <div class="wrap prose">
      <h2>{s('installTitle')}</h2>
      <p>{s('installBrew')}</p>
      <pre><code>brew install --cask fortunto2/tap/life2film-studio</code></pre>
      <p>{s('installDmg')}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{s('doesTitle')}</h2>
      <div class="grid cols-3 steps">
        {steps.map((st, i) => (
          <div class="card">
            <span class="num gradient-text">{String(i + 1).padStart(2, '0')}</span>
            <h3>{st.t}</h3>
            <p>{st.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{s('featTitle')}</h2>
      <figure class="shot tight">
        <img src="/img/studio-sound.jpg" alt={s('shotSound')} width="2000" height="1054" loading="lazy" decoding="async" />
        <figcaption>{s('shotSound')}</figcaption>
      </figure>
      <div class="grid cols-3 feats">
        {feats.map((f) => (
          <div class="card">
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </div>
        ))}
      </div>
      <figure class="shot">
        <img src="/img/studio-words.jpg" alt={s('shotWords')} width="2000" height="1054" loading="lazy" decoding="async" />
        <figcaption>{s('shotWords')}</figcaption>
      </figure>
    </div>
  </section>

  <section>
    <div class="wrap prose">
      <h2>{s('agentTitle')}</h2>
      <p>{s('agentBody')}</p>
      <pre><code>{MCP}</code></pre>
      <p>{s('agentAfter')}</p>
      <p><a href="/studio/agent/">{s('agentLink')} →</a></p>

      <h2>{s('betaTitle')}</h2>
      <p>{s('betaBody')}</p>
      <p>
        {s('betaContact')} <a href="mailto:info@life2film.com">info@life2film.com</a>
      </p>
    </div>
  </section>
</main>

<style>
  .hero { padding-top: 56px; }
  .appicon { display: block; width: 96px; height: 96px; margin: 0 0 18px -8px; }
  h1 { font-size: clamp(40px, 6vw, 60px); margin: 16px 0 18px; }
  .lede { font-size: 19px; color: #cfcfd6; max-width: 62ch; }
  .lede-sub { max-width: 60ch; margin-top: 10px; }
  .badge.beta { border-color: #33333d; color: var(--cyan); }

  .cta { margin: 28px 0 10px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .small { font-size: 14px; }
  .btn-ghost {
    display: inline-flex; align-items: center; padding: 12px 22px; border-radius: 12px;
    border: 1px solid var(--line); background: var(--panel); color: var(--fg);
    text-decoration: none; font-size: 15px; font-weight: 500;
  }
  .btn-ghost:hover { border-color: #33333d; }

  .shot { margin: 44px 0 0; }
  .shot.tight { margin-top: 24px; }
  .shot img { width: 100%; height: auto; display: block; border-radius: 16px; border: 1px solid var(--line); }
  .shot figcaption { margin-top: 12px; font-size: 14px; color: var(--muted); }

  .steps, .feats { margin-top: 28px; }
  .num { display: block; font-size: 13px; font-weight: 700; letter-spacing: 0.1em; margin-bottom: 10px; }

  .chips { list-style: none; padding: 0; margin: 0 0 14px; display: flex; flex-wrap: wrap; gap: 7px; }
  .chips li {
    font-size: 12.5px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    padding: 4px 9px; border-radius: 7px;
    background: #16161b; border: 1px solid var(--line); color: #b9b9c4;
  }

  pre {
    background: var(--panel); border: 1px solid var(--line); border-radius: 12px;
    padding: 16px 18px; overflow-x: auto; margin: 12px 0 18px;
  }
  pre code { background: none; padding: 0; font-size: 14px; color: var(--cyan); }
</style>
