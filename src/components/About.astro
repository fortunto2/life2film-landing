---
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<main>
  <section>
    <div class="wrap prose">
      <h1>{t('aboutTitle')}</h1>

      <blockquote>{t('aboutQuote')}</blockquote>

      <p>{t('aboutP1')}</p>
      <p>{t('aboutP2')}</p>

      <h2>{t('aboutH6')}</h2>
      <p>{t('aboutP7')}</p>

      {/* The 2014 film, as a facade: a poster we host and one button. The YouTube
          iframe (youtube-nocookie) is created only on the press, so opening this page
          sends nothing to Google — the same promise the paragraph above it makes. */}
      <div class="film" data-video="HpqiNjCTVIU">
        <button type="button" class="film-play" aria-label={t('aboutVideoPlay')}>
          <img src="/img/life2film-2014.jpg" width="1280" height="720" alt="" loading="lazy" decoding="async" />
          <span class="film-badge" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
            {t('aboutVideoPlay')}
          </span>
        </button>
      </div>
      <p class="film-note">{t('aboutVideoNote')}</p>

      <h2>{t('aboutH2')}</h2>
      <p>{t('aboutP3')}</p>

      <h2>{t('aboutH3')}</h2>
      <p>{t('aboutP4')}</p>

      <h2>{t('aboutH4')}</h2>
      <p>{t('aboutP5')}</p>

      <h2>{t('aboutH5')}</h2>
      <p>{t('aboutP6')}</p>

      <address class="company">
        <strong>SuperDuperAi, Corp.</strong><br />
        1207 Delaware Ave, Unit 4241<br />
        Wilmington, DE 19806, USA<br />
        <a href="mailto:info@life2film.com">info@life2film.com</a> ·
        <a href="tel:+18186190966">+1 818 619 0966</a><br />
        <a href="https://superduperai.co" rel="noopener">superduperai.co</a>
      </address>
    </div>
  </section>
</main>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('.film[data-video]')) {
    const button = box.querySelector('button');
    button?.addEventListener(
      'click',
      () => {
        const frame = document.createElement('iframe');
        frame.src = `https://www.youtube-nocookie.com/embed/${box.dataset.video}?autoplay=1&rel=0`;
        frame.title = button.getAttribute('aria-label') ?? '';
        frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        frame.referrerPolicy = 'strict-origin-when-cross-origin';
        box.replaceChildren(frame);
      },
      { once: true },
    );
  }
</script>

<style>
  .film {
    position: relative;
    aspect-ratio: 16 / 9;
    margin: 8px 0 10px;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: #000;
  }
  .film-play {
    all: unset;
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }
  .film-play:focus-visible { outline: 2px solid var(--cyan); outline-offset: -2px; }
  .film-play img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .film-badge {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px 10px 14px;
    border-radius: 999px;
    background: rgba(12, 12, 16, 0.78);
    border: 1px solid var(--line);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    transition: background 0.15s ease;
  }
  .film-play:hover .film-badge { background: rgba(12, 12, 16, 0.92); }
  .film iframe { display: block; width: 100%; height: 100%; border: 0; }
  .film-note { margin: 0 0 28px; font-size: 14px; color: #9a9aa3; }

  h1 { font-size: clamp(32px, 5vw, 44px); margin-bottom: 24px; }
  .company {
    margin-top: 18px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--panel);
    font-style: normal;
    font-size: 15px;
    line-height: 1.8;
    color: #cfcfd6;
  }
  .company a { color: var(--cyan); text-decoration: none; }
  .company a:hover { text-decoration: underline; }

  blockquote {
    margin: 0 0 32px;
    padding: 20px 24px;
    border-left: 3px solid transparent;
    border-image: linear-gradient(180deg, var(--cyan), var(--pink), var(--yellow)) 1;
    background: var(--panel);
    border-radius: 0 12px 12px 0;
    font-size: 18px;
    line-height: 1.55;
    color: #e4e4ea;
  }
</style>
