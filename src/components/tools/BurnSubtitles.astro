---
import { CHROME, STATUS } from '../../lib/tools-i18n';
import type { Lang } from '../../i18n';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const chrome = CHROME[lang];
const status = STATUS[lang];

const WORDS: Partial<Record<Lang, Record<string, string>>> = {
  en: { video: 'Video', subs: 'Subtitles (.srt or .vtt)', pickSubs: 'Choose subtitles', size: 'Text size', s: 'small', m: 'medium', l: 'large', pos: 'Position', bottom: 'bottom', top: 'top', run: 'Burn in', found: '{n} subtitles read.', saved: 'Saved — {size}, {n} subtitles on screen.', failed: 'Could not burn the subtitles — {msg}', need: 'Choose a video and a subtitle file.' },
  ru: { video: 'Видео', subs: 'Субтитры (.srt или .vtt)', pickSubs: 'Выбрать субтитры', size: 'Размер текста', s: 'мелкий', m: 'средний', l: 'крупный', pos: 'Где', bottom: 'внизу', top: 'вверху', run: 'Вшить', found: 'Прочитано субтитров: {n}.', saved: 'Сохранено — {size}, субтитров на экране: {n}.', failed: 'Не удалось вшить субтитры — {msg}', need: 'Выберите видео и файл субтитров.' },
  es: { video: 'Video', subs: 'Subtítulos (.srt o .vtt)', pickSubs: 'Elegir subtítulos', size: 'Tamaño', s: 'pequeño', m: 'mediano', l: 'grande', pos: 'Posición', bottom: 'abajo', top: 'arriba', run: 'Incrustar', found: '{n} subtítulos leídos.', saved: 'Guardado — {size}, {n} subtítulos en pantalla.', failed: 'No se pudieron incrustar — {msg}', need: 'Elige un video y un archivo de subtítulos.' },
  pt: { video: 'Vídeo', subs: 'Legendas (.srt ou .vtt)', pickSubs: 'Escolher legendas', size: 'Tamanho', s: 'pequeno', m: 'médio', l: 'grande', pos: 'Posição', bottom: 'embaixo', top: 'em cima', run: 'Embutir', found: '{n} legendas lidas.', saved: 'Salvo — {size}, {n} legendas na tela.', failed: 'Não foi possível embutir — {msg}', need: 'Escolha um vídeo e um arquivo de legendas.' },
  id: { video: 'Video', subs: 'Subtitle (.srt atau .vtt)', pickSubs: 'Pilih subtitle', size: 'Ukuran teks', s: 'kecil', m: 'sedang', l: 'besar', pos: 'Posisi', bottom: 'bawah', top: 'atas', run: 'Tanamkan', found: '{n} subtitle terbaca.', saved: 'Tersimpan — {size}, {n} subtitle di layar.', failed: 'Gagal menanamkan subtitle — {msg}', need: 'Pilih video dan file subtitle.' },
  tr: { video: 'Video', subs: 'Altyazı (.srt veya .vtt)', pickSubs: 'Altyazı seç', size: 'Yazı boyutu', s: 'küçük', m: 'orta', l: 'büyük', pos: 'Konum', bottom: 'alt', top: 'üst', run: 'Göm', found: '{n} altyazı okundu.', saved: 'Kaydedildi — {size}, ekranda {n} altyazı.', failed: 'Altyazı gömülemedi — {msg}', need: 'Bir video ve bir altyazı dosyası seçin.' },
  ar: { video: 'الفيديو', subs: 'الترجمة (.srt أو .vtt)', pickSubs: 'اختر ملف الترجمة', size: 'حجم النص', s: 'صغير', m: 'متوسط', l: 'كبير', pos: 'الموضع', bottom: 'أسفل', top: 'أعلى', run: 'دمج الترجمة', found: 'تمت قراءة {n} ترجمة.', saved: 'تم الحفظ — {size}، {n} ترجمة على الشاشة.', failed: 'تعذّر دمج الترجمة — {msg}', need: 'اختر فيديو وملف ترجمة.' },
};
const words = WORDS[lang] ?? WORDS.en!;
---

<div class="tool" slot="tool">
  <span id="i18n" data-strings={JSON.stringify(status)} hidden></span>
  <span id="words" data-words={JSON.stringify(words)} hidden></span>
  <label class="drop" id="drop" for="file">
    <input type="file" id="file" accept="video/*,.srt,.vtt" multiple hidden />
    <strong>{chrome.chooseFile}</strong>
    <span class="muted">{chrome.dragHint} — {words.video} + .srt / .vtt</span>
  </label>
  <div class="facts" id="facts"></div>
  <div class="controls">
    <label class="ghost" for="subs">{words.pickSubs}<input type="file" id="subs" accept=".srt,.vtt,text/vtt,application/x-subrip" hidden /></label>
    <label class="control"><span class="muted">{words.size}</span>
      <select id="size"><option value="s">{words.s}</option><option value="m" selected>{words.m}</option><option value="l">{words.l}</option></select></label>
    <label class="control"><span class="muted">{words.pos}</span>
      <select id="pos"><option value="bottom" selected>{words.bottom}</option><option value="top">{words.top}</option></select></label>
    <span class="spacer"></span>
    <button id="run" type="button" class="ghost primary" data-sda-event="tool_run" data-sda-placement="controls">{words.run}</button>
  </div>
  <div id="status" class="status" hidden>
    <div class="bar"><span id="fill"></span></div>
    <div class="statustext" id="statusText"></div>
  </div>
</div>

<style>
  label.ghost { cursor: pointer; }
  .facts { display: flex; gap: 16px; flex-wrap: wrap; margin: 10px 0; }
</style>

<script>
  import { fileChosen, toolFailed, track } from '../../lib/track';
  import { toolStrings, fill } from '../../lib/strings';
  import { saveBlob, formatBytes } from '../../lib/encode';
  import { burnSubtitles, parseCues, type Cue } from '../../lib/subtitles';

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const say = toolStrings();
  const w = JSON.parse(el('words').dataset.words ?? '{}') as Record<string, string>;
  const statusEl = el<HTMLDivElement>('status');
  const drop = el<HTMLLabelElement>('drop');
  let video: File | null = null;
  let cues: Cue[] = [];
  let subsName = '';
  let busy = false;

  function status(message: string, fraction?: number, isError = false) {
    statusEl.hidden = false;
    statusEl.classList.toggle('err', isError);
    el('statusText').textContent = message;
    if (fraction !== undefined) el('fill').style.width = `${Math.round(fraction * 100)}%`;
  }

  function facts() {
    const parts: string[] = [];
    if (video) parts.push(`${w.video}: ${video.name}`);
    if (subsName) parts.push(`${subsName} — ${w.found.replace('{n}', String(cues.length))}`);
    el('facts').replaceChildren(...parts.map((t) => { const s = document.createElement('span'); s.textContent = t; return s; }));
  }

  async function take(list: FileList | null | undefined, how: 'picker' | 'drop') {
    for (const f of [...(list ?? [])]) {
      if (/\.(srt|vtt)$/i.test(f.name)) {
        cues = parseCues(await f.text());
        subsName = f.name;
      } else if (f.type.startsWith('video/') || /\.(mp4|mov|webm|mkv|m4v)$/i.test(f.name)) {
        video = f;
        fileChosen(f, how);
      }
    }
    statusEl.hidden = true;
    facts();
  }

  el<HTMLButtonElement>('run').addEventListener('click', async () => {
    if (busy) return;
    if (!video || !cues.length) { status(w.need, 1, true); return; }
    busy = true;
    el<HTMLButtonElement>('run').disabled = true;
    try {
      status(fill(say.working, { n: 0 }), 0);
      const result = await burnSubtitles(video, cues, {
        size: el<HTMLSelectElement>('size').value as 's' | 'm' | 'l',
        position: el<HTMLSelectElement>('pos').value as 'bottom' | 'top',
        onProgress: (p) => status(fill(say.working, { n: Math.round(p * 100) }), p),
      });
      saveBlob(result.blob, `${video.name.replace(/\.[^.]+$/, '') || 'video'}-subtitled.mp4`);
      track('result_saved', { placement: 'result', format: 'mp4' }, { size_mb: Math.round(result.blob.size / 104_857.6) / 10, cues: cues.length });
      status(w.saved.replace('{size}', formatBytes(result.blob.size)).replace('{n}', String(result.shown)), 1);
    } catch (error) {
      toolFailed('run', error, video);
      status(w.failed.replace('{msg}', error instanceof Error ? error.message : String(error)), 1, true);
    } finally {
      busy = false;
      el<HTMLButtonElement>('run').disabled = false;
    }
  });

  el<HTMLInputElement>('file').addEventListener('change', (e) => void take((e.target as HTMLInputElement).files, 'picker'));
  el<HTMLInputElement>('subs').addEventListener('change', (e) => void take((e.target as HTMLInputElement).files, 'picker'));
  for (const t of ['dragenter', 'dragover']) drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.add('over'); });
  for (const t of ['dragleave', 'drop']) drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.remove('over'); });
  drop.addEventListener('drop', (e) => void take((e as DragEvent).dataTransfer?.files, 'drop'));
</script>
