---
import { CHROME, STATUS } from '../../lib/tools-i18n';
import { SPLITTER } from '../../lib/splitter-i18n';
import type { Lang } from '../../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const chrome = CHROME[lang];
const status = STATUS[lang];
const sp = SPLITTER[lang];
const fill = (t: string, n: number) => t.replace('{n}', String(n));

/**
 * The video-splitter interface: markup and behaviour, with no page metadata.
 *
 * Separated from the page so the localised routes can render exactly the same tool. The
 * words around it come from the registry; this is the part that does the work.
 */
---

<div class="tool" slot="tool">
    <span id="i18n" data-strings={JSON.stringify(status)} hidden></span>
    <span id="sp" data-strings={JSON.stringify(sp)} hidden></span>
          <label class="drop" id="drop" for="file">
            <input type="file" id="file" accept="video/*" hidden />
            <strong>{chrome.chooseVideo}</strong>
            <span class="muted">{chrome.dragHint} — {sp.hint}</span>
          </label>

          <div class="controls" id="controls" hidden>
            <label class="control">
              <span class="muted">{sp.splitBy}</span>
              <select id="mode">
                <option value="scenes" selected>{sp.byScenes}</option>
                <option value="parts">{sp.byParts}</option>
                <option value="every">{sp.byEvery}</option>
              </select>
            </label>

            <label class="control" id="partsWrap" hidden>
              <select id="parts">
                {[2, 3, 4, 5, 6, 8, 10].map((n) => <option value={n} selected={n === 2}>{fill(sp.parts, n)}</option>)}
              </select>
            </label>

            <label class="control" id="everyWrap" hidden>
              <span class="muted">{sp.every}</span>
              <select id="every">
                {[15, 30, 60, 120, 300, 600, 900].map((n) => (
                  <option value={n} selected={n === 60}>{n < 60 ? `${n} ${sp.seconds}` : `${n / 60} ${sp.minutes}`}</option>
                ))}
              </select>
            </label>

            <label class="control" id="targetWrap">
              <span class="muted">{sp.clipLength}</span>
              <select id="target">
                <option value="15">~15s — Stories</option>
                <option value="30" selected>~30s — Reels, TikTok</option>
                <option value="60">~60s — Shorts</option>
                <option value="90">~90s — long Reels</option>
              </select>
            </label>

            <label class="control checkbox">
              <input type="checkbox" id="vertical" />
              <span>{sp.crop}</span>
            </label>

            <span class="spacer"></span>

            <button id="downloadAll" type="button" class="ghost primary">{sp.downloadSelected}</button>
          </div>

          <div id="status" class="status" hidden>
            <div class="bar"><span id="fill"></span></div>
            <div class="statustext" id="statusText"></div>
          </div>

          <div id="summary" class="summary" hidden></div>
          <div class="clips" id="clipGrid"></div>
        </div>

  {lang === 'en' && (
  <Fragment slot="prose">
        <h2>Why cut on the shot, not on the clock</h2>
        <p>
          A thirty-second rule knows nothing about the video it is cutting. It will end a clip in the
          middle of a movement and open the next one on the tail of it, and the join is visible to
          anyone watching, the first second of a clip is the second that decides whether they stay.
        </p>
        <p>
          A shot change is a boundary the footage already contains. Starting there means each clip
          opens on something new, which is what a person would do by hand. That is the only real
          difference here, and it is the whole point.
        </p>

        <h2>What it does not do</h2>
        <p>
          It does not read speech, so it cannot find the moment someone says something quotable —
          tools built around transcription do that, and they do it well. It does not track faces, so
          the vertical crop takes the centre of the frame and trusts you to look at the previews.
        </p>
        <p>
          What it does have is the picture: where the shots are, and which of them are sharp,
          well-exposed and worth a viewer's attention. For footage without much talking (travel,
          action, b-roll, anything shot on a gimbal) that is the information that matters.
        </p>

        <h2>How it works</h2>
        <p>
          The <a href="/tools/scene-detector/">scene detector</a> finds the shot boundaries, the same
          per-frame scorer that <a href="/">Life2Film</a> uses ranks them, and the clips are grouped
          so no cut ever lands inside a shot. Encoding uses the browser's own video pipeline, so the
          output is a normal MP4 with no watermark.
        </p>
    </Fragment>
)}
{/* Global: the cards are built with innerHTML, so they never get Astro's scoping attribute and
    scoped rules never matched them. Only this tool's CSS loads on its page. */}
<style is:global>
    .tool select {
      padding: 9px 12px; border-radius: 10px; font: inherit; font-size: 14px; cursor: pointer;
      color: var(--fg); background: #0a0a0d; border: 1px solid var(--line);
    }
    .tool select:hover { border-color: var(--cyan); }

    .summary { margin-top: 18px; font-size: 15px; color: #cfcfd6; }
    .summary b { color: var(--fg); }

    .clips { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); margin-top: 16px; }
    .clip {
      border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: #08080a;
      display: flex; flex-direction: column;
    }
    .clip.on { border-color: rgba(0,242,224,.5); }
    .clip .shell { position: relative; cursor: pointer; }
    .clip img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: #111; }
    .clip .pick {
      position: absolute; top: 8px; left: 8px; width: 20px; height: 20px;
      accent-color: #00f2e0; cursor: pointer;
    }
    .clip .rank {
      position: absolute; top: 8px; right: 8px; padding: 2px 7px; border-radius: 999px;
      background: rgba(5,5,6,.78); font-size: 11px; letter-spacing: .06em; color: var(--cyan);
    }
    .clip .info { padding: 9px 11px; display: grid; gap: 3px; }
    .clip .tc { font-size: 13px; font-family: ui-monospace, monospace; }
    .clip .len { font-size: 12px; color: var(--muted); }
    .clip .act { padding: 0 11px 11px; }
    .clip .act button {
      width: 100%; padding: 7px; border-radius: 8px; font: inherit; font-size: 13px; cursor: pointer;
      color: var(--fg); background: transparent; border: 1px solid var(--line);
    }
    .clip .act button:hover:not(:disabled) { border-color: var(--cyan); color: var(--cyan); }
    .clip .act button:disabled { opacity: .5; cursor: default; }
</style>

<script>
    import { fileChosen, toolFailed, track } from '../../lib/track';
  import { toolStrings } from '../../lib/strings';
    import { encode, saveBlob } from '../../lib/encode';
    import { loadEngine } from '../../lib/engine';
    import { openVideo, samplePlan, centerPixel, refineBoundary, type VideoSource } from '../../lib/frames';
    import { equalClips, groupIntoClips, rankByScore, stars, type Clip, type Shot } from '../../lib/clips';
    import type { SplitterChrome } from '../../lib/splitter-i18n';
    import { clock } from '../../lib/timeline-export';

    const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const say = toolStrings();
    const sp = JSON.parse(document.getElementById('sp')!.dataset.strings!) as SplitterChrome;

    const drop = el<HTMLLabelElement>('drop');
    const fileInput = el<HTMLInputElement>('file');
    const statusEl = el<HTMLDivElement>('status');
    const grid = el<HTMLDivElement>('clipGrid');

    const ANALYSIS_WIDTH = 64;
    const THUMB_WIDTH = 380;
    const MAX_MINUTES = 10;

    let shots: Shot[] = [];
    let clips: Clip[] = [];
    let sourceFile: File | null = null;
    let videoDuration = 0;
    let fileName = 'video';
    let busy = false;

    function status(message: string, fraction?: number, isError = false) {
      statusEl.hidden = false;
      statusEl.classList.toggle('err', isError);
      el('statusText').textContent = message;
      if (fraction !== undefined) el('fill').style.width = `${Math.round(fraction * 100)}%`;
    }

    const target = () => Number(el<HTMLSelectElement>('target').value) || 30;
    const wantsVertical = () => el<HTMLInputElement>('vertical').checked;
    type Mode = 'scenes' | 'parts' | 'every';
    const mode = () => el<HTMLSelectElement>('mode').value as Mode;

    function syncModeUI() {
      el('targetWrap').hidden = mode() !== 'scenes';
      el('partsWrap').hidden = mode() !== 'parts';
      el('everyWrap').hidden = mode() !== 'every';
    }

    function start(file: File) {
      // The guard comes BEFORE anything is overwritten: a file dropped mid-export used to replace
      // `sourceFile`, and the remaining clips were cut from the new file at the old timestamps.
      if (busy) return;
      syncModeUI();
      sourceFile = file;
      fileName = file.name.replace(/\.[^.]+$/, '') || 'video';
      shots = [];
      void (mode() === 'scenes' ? analyse(file) : showEqual(file));
    }

    /** Cut on the clock: no analysis, so no length limit and no engine download. */
    async function showEqual(file: File, note?: string) {
      if (busy) return;
      busy = true;
      grid.replaceChildren();
      let source: VideoSource | null = null;
      try {
        status(say.reading, 0.1);
        source = await openVideo(file);
        videoDuration = source.duration;
        el('controls').hidden = false;
        await rebuild(source);
        track('result_shown', { placement: 'result', mode: mode() }, {
          clips: clips.length,
          duration_s: Math.round(videoDuration),
        });
        if (note) status(note, 1);
        else statusEl.hidden = true;
      } catch (error) {
        toolFailed('open', error, file);
        status(error instanceof Error ? error.message : 'Could not read that file.', 1, true);
      } finally {
        source?.release();
        busy = false;
      }
    }

    // --- analysis ---

    async function analyse(file: File) {
      if (busy) return;
      busy = true;
      sourceFile = file;
      fileName = file.name.replace(/\.[^.]+$/, '') || 'video';
      grid.replaceChildren();
      el('summary').hidden = true;
      el('controls').hidden = true;

      let source: VideoSource | null = null;
      let switched = false;

      try {
        status(say.reading, 0.02);
        source = await openVideo(file);
        videoDuration = source.duration;

        // Reading frames means seeking through the whole file, so past ten minutes the scene pass
        // takes longer than it is worth. Rather than refuse — «разделить большое видео на части» is
        // a real query — switch to cutting on the clock, which needs no analysis at all.
        if (source.duration > MAX_MINUTES * 60) {
          el<HTMLSelectElement>('mode').value = 'every';
          syncModeUI();
          switched = true;
          return;
        }

        const engine = await loadEngine();
        const plan = samplePlan(source.duration);
        const coarseStep = source.duration / plan.length;

        const pixels: Array<{ r: number; g: number; b: number }> = [];
        const timestamps: number[] = [];
        const scores: Array<{ timestamp: number; score: number }> = [];

        for (const [i, at] of plan.entries()) {
          const frame = await source.frameAt(at, ANALYSIS_WIDTH);
          pixels.push(centerPixel(frame));
          timestamps.push(at);

          const scored = JSON.parse(
            engine.score_frame(frame.width, frame.height, frame.rgb24, at, null),
          ) as { score?: number; error?: string };
          if (!scored.error) scores.push({ timestamp: at, score: scored.score ?? 0 });

          if (i % 8 === 0) status(`Reading the video — ${i + 1} of ${plan.length} frames`, ((i + 1) / plan.length) * 0.75);
        }

        status('Finding the shot changes…', 0.8);

        const detected = JSON.parse(
          engine.detect_scenes_slick(
            JSON.stringify({ pixels, timestamps, duration: source.duration, algo: 'adjacent_diffs' }),
          ),
        ) as { scenes?: Array<[number, number]>; error?: string };
        if (detected.error) throw new Error(detected.error);

        const ranges = detected.scenes?.length
          ? detected.scenes
          : [[0, source.duration] as [number, number]];

        // Refine each boundary at ten times the coarse resolution — a cut reported half a second
        // late is a clip that opens on the end of the previous shot.
        const moved = new Map<number, number>();
        const starts = ranges.slice(1).map(([start]) => start);
        for (const [i, start] of starts.entries()) {
          status(`Placing cut ${i + 1} of ${starts.length}…`, 0.82 + (i / starts.length) * 0.16);
          moved.set(start, await refineBoundary(source, start, coarseStep, ANALYSIS_WIDTH, {
            previous: starts[i - 1] ?? 0,
            next: starts[i + 1] ?? source.duration,
          }));
        }

        shots = ranges.map(([start, end]) => {
          const inside = scores.filter((s) => s.timestamp >= start && s.timestamp < end).map((s) => s.score);
          inside.sort((a, b) => a - b);
          return {
            start: moved.get(start) ?? start,
            end: moved.get(end) ?? end,
            score: inside.length ? inside[Math.floor(inside.length / 2)] : 0,
          };
        });

        statusEl.hidden = true;
        el('controls').hidden = false;
        await rebuild(source);
        track('result_shown', { placement: 'result', mode: 'scenes' }, {
          clips: clips.length,
          shots: shots.length,
          duration_s: Math.round(videoDuration),
        });
      } catch (error) {
        toolFailed('analyse', error, file);
        status(error instanceof Error ? error.message : 'Could not read that file.', 1, true);
      } finally {
        source?.release();
        busy = false;
        if (switched) void showEqual(file, sp.tooLong);
      }
    }

    /** Regroup and redraw — cheap, because the shots are already known. */
    async function rebuild(source: VideoSource) {
      const scenes = mode() === 'scenes';
      clips = scenes
        ? groupIntoClips(shots, { target: target() })
        : equalClips(
            videoDuration,
            mode() === 'parts'
              ? { parts: Number(el<HTMLSelectElement>('parts').value) || 2 }
              : { every: Number(el<HTMLSelectElement>('every').value) || 60 },
          );
      const order = rankByScore(clips);
      const best = clips.length ? clips[order[0]].score : 0;

      el('summary').hidden = false;
      el('summary').innerHTML = scenes
        ? `<b>${clips.length}</b> clips from <b>${shots.length}</b> shots · ` +
          `${clock(videoDuration)} of video · best clip is #${order[0] + 1}`
        : sp.summaryParts.replace('{n}', String(clips.length)).replace('{length}', clock(videoDuration));

      grid.replaceChildren();

      for (const [i, clip] of clips.entries()) {
        const rank = order.indexOf(i) + 1;
        const card = document.createElement('div');
        card.className = 'clip on';
        card.innerHTML = `
          <div class="shell">
            <img alt="Clip ${i + 1}" loading="lazy" />
            <input class="pick" type="checkbox" checked aria-label="Include clip ${i + 1}" />
            ${scenes ? `<span class="rank">${'★'.repeat(stars(clip, best))}${rank === 1 ? ' BEST' : ''}</span>` : ''}
          </div>
          <div class="info">
            <span class="tc">${clock(clip.start)} – ${clock(clip.end)}</span>
            <span class="len">#${i + 1} · ${(clip.end - clip.start).toFixed(1)}s${scenes ? ` · ${clip.shots} shot${clip.shots > 1 ? 's' : ''}` : ''}</span>
          </div>
          <div class="act"><button type="button">${sp.download}</button></div>`;

        const pick = card.querySelector<HTMLInputElement>('.pick')!;
        pick.addEventListener('change', () => card.classList.toggle('on', pick.checked));
        card.querySelector('button')!.addEventListener('click', () => void exportClips([i]));
        grid.append(card);

        const at = Math.min(clip.start + 0.3, clip.end - 0.05, videoDuration - 0.05);
        try {
          card.querySelector('img')!.src = await source.thumbnailAt(Math.max(0, at), THUMB_WIDTH);
        } catch {
          // A missing thumbnail does not invalidate the clip it belongs to.
        }
      }
    }

    // --- encoding ---

    /**
     * Cut the selected clips out of the source and hand them over as MP4s.
     *
     * mediabunny drives WebCodecs, so this is the browser's own video pipeline — hardware where
     * available — rather than a copy of ffmpeg shipped over the wire.
     */
    async function exportClips(indices: number[]) {
      if (busy || !sourceFile || !indices.length) return;
      busy = true;
      setButtons(false);

      // Pinned for the whole export: `start()` is guarded by `busy`, but reading module state per
      // iteration is still one dropped file away from cutting the wrong video.
      const file = sourceFile;
      const name = fileName;
      const kind = mode() === 'scenes' ? 'clip' : 'part';
      const vertical = wantsVertical();

      try {
        for (const [n, index] of indices.entries()) {
          const clip = clips[index];
          const label = `${kind} ${n + 1} of ${indices.length}`;
          status(`Encoding ${label}…`, n / indices.length);

          // Through `encode`, not mediabunny by hand: the H.264-first codec choice, the hardware
          // hint and the readable "cannot encode" reasons all live there.
          const blob = await encode(file, {
            container: 'mp4',
            trim: { start: clip.start, end: clip.end },
            ...(vertical ? { width: 1080, height: 1920, fit: 'cover' as const } : {}),
            onProgress: (progress) =>
              status(`Encoding ${label} — ${Math.round(progress * 100)}%`, (n + progress) / indices.length),
          });

          saveBlob(blob, `${name}-${kind}-${index + 1}${vertical ? '-9x16' : ''}.mp4`);
        }

        track(
          'result_saved',
          { placement: indices.length === 1 && clips.length > 1 ? 'clip' : 'result', mode: mode(), vertical: String(wantsVertical()) },
          { clips: indices.length },
        );
        status(`Done — ${indices.length} clip${indices.length > 1 ? 's' : ''} saved.`, 1);
        setTimeout(() => { statusEl.hidden = true; }, 4000);
      } catch (error) {
        toolFailed('save', error, sourceFile);
        status(
          error instanceof Error
            ? `Encoding failed — ${error.message}`
            : 'Encoding failed.',
          1,
          true,
        );
      } finally {
        busy = false;
        setButtons(true);
      }
    }

    function setButtons(enabled: boolean) {
      el<HTMLButtonElement>('downloadAll').disabled = !enabled;
      for (const button of grid.querySelectorAll('button')) button.disabled = !enabled;
    }

    const selected = () =>
      [...grid.querySelectorAll<HTMLInputElement>('.pick')]
        .map((box, i) => (box.checked ? i : -1))
        .filter((i) => i >= 0);

    el<HTMLButtonElement>('downloadAll').addEventListener('click', () => void exportClips(selected()));

    // Regrouping needs the video again for thumbnails, so it reopens the file rather than holding
    // a decoder alive for the whole session.
    el<HTMLSelectElement>('target').addEventListener('change', async () => {
      if (!sourceFile || !shots.length || busy) return;
      await regroup();
    });

    /** Reopen and redraw; `busy` is released on every path, including a reopen that fails. */
    async function regroup() {
      if (!sourceFile) return;
      busy = true;
      let source: VideoSource | null = null;
      try {
        source = await openVideo(sourceFile);
        await rebuild(source);
      } catch (error) {
        toolFailed('open', error, sourceFile);
        status(error instanceof Error ? error.message : 'Could not reopen that file.', 1, true);
      } finally {
        source?.release();
        busy = false;
      }
    }

    // Switching mode or part size: scenes need the analysis once, the clock never does.
    for (const id of ['mode', 'parts', 'every']) {
      el<HTMLSelectElement>(id).addEventListener('change', async () => {
        syncModeUI();
        if (!sourceFile || busy) return;
        if (mode() === 'scenes' && !shots.length) return void analyse(sourceFile);
        await regroup();
      });
    }

    syncModeUI();

    // --- input ---

    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) { fileChosen(file, 'picker'); start(file); }
    });

    for (const type of ['dragenter', 'dragover']) {
      drop.addEventListener(type, (e) => {
        e.preventDefault();
        drop.classList.add('over');
      });
    }
    for (const type of ['dragleave', 'drop']) {
      drop.addEventListener(type, (e) => {
        e.preventDefault();
        drop.classList.remove('over');
      });
    }
    drop.addEventListener('drop', (e) => {
      const file = (e as DragEvent).dataTransfer?.files?.[0];
      if (file) { fileChosen(file, 'drop'); start(file); }
    });
</script>
