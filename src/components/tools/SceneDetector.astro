---
import { CHROME } from '../../lib/tools-i18n';
import type { Lang } from '../../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const chrome = CHROME[lang];

// The detector choice and its two knobs, in the page's language. Three of the Life2Film core's
// detectors (shots.ts says which is which and why).
const TUNE: Record<Lang, Record<string, string>> = {
  en: { watch: 'Watch', download: 'Download', fullscreen: 'Full screen', method: 'Detector', strict: 'Strict — two detectors agree', camera: 'Camera footage — colour change', edited: 'Edited video — films, ads, clips', sensitivity: 'Sensitivity', minShot: 'Shortest shot', hint_strict: 'Fewest false cuts; may miss cuts between similar shots.', hint_camera: 'The Life2Film app\'s default: a cut is a jump in colour and brightness.', hint_edited: 'A cut must stand out from the seconds around it. Best for edited video; finds little in one continuous take.' },
  ru: { watch: 'Смотреть', download: 'Скачать', fullscreen: 'Во весь экран', method: 'Детектор', strict: 'Строгий — два детектора согласны', camera: 'Съёмка с камеры — смена цвета', edited: 'Смонтированное видео — фильмы, реклама, клипы', sensitivity: 'Чувствительность', minShot: 'Самый короткий план', hint_strict: 'Меньше всего ложных склеек; может пропустить склейку между похожими планами.', hint_camera: 'Как в приложении Life2Film: склейка — это скачок цвета и яркости.', hint_edited: 'Склейка должна выделяться на фоне соседних секунд. Лучше всего для смонтированного видео; в одном непрерывном дубле найдёт мало.' },
  es: { watch: 'Ver', download: 'Descargar', fullscreen: 'Pantalla completa', method: 'Detector', strict: 'Estricto — dos detectores coinciden', camera: 'Grabación de cámara — cambio de color', edited: 'Vídeo editado — películas, anuncios, clips', sensitivity: 'Sensibilidad', minShot: 'Plano más corto', hint_strict: 'Menos cortes falsos; puede saltarse cortes entre planos parecidos.', hint_camera: 'Lo que usa la app Life2Film: un corte es un salto de color y brillo.', hint_edited: 'Un corte debe destacar sobre los segundos de alrededor. Ideal para vídeo editado; en una toma continua encuentra poco.' },
  pt: { watch: 'Assistir', download: 'Baixar', fullscreen: 'Tela cheia', method: 'Detector', strict: 'Estrito — dois detectores concordam', camera: 'Gravação de câmera — mudança de cor', edited: 'Vídeo editado — filmes, anúncios, clipes', sensitivity: 'Sensibilidade', minShot: 'Plano mais curto', hint_strict: 'Menos cortes falsos; pode perder cortes entre planos parecidos.', hint_camera: 'O padrão do app Life2Film: um corte é um salto de cor e brilho.', hint_edited: 'Um corte precisa se destacar dos segundos ao redor. Melhor para vídeo editado; numa tomada contínua acha pouco.' },
  id: { watch: 'Tonton', download: 'Unduh', fullscreen: 'Layar penuh', method: 'Detektor', strict: 'Ketat — dua detektor sepakat', camera: 'Rekaman kamera — perubahan warna', edited: 'Video hasil edit — film, iklan, klip', sensitivity: 'Sensitivitas', minShot: 'Shot terpendek', hint_strict: 'Potongan palsu paling sedikit; bisa melewatkan potongan antar shot yang mirip.', hint_camera: 'Bawaan aplikasi Life2Film: potongan adalah lonjakan warna dan kecerahan.', hint_edited: 'Potongan harus menonjol dari detik di sekitarnya. Terbaik untuk video hasil edit; di satu take panjang hanya menemukan sedikit.' },
  ar: { watch: 'مشاهدة', download: 'تنزيل', fullscreen: 'ملء الشاشة', method: 'الكاشف', strict: 'صارم — يتفق كاشفان', camera: 'تصوير الكاميرا — تغيّر اللون', edited: 'فيديو مُحرَّر — أفلام وإعلانات ومقاطع', sensitivity: 'الحساسية', minShot: 'أقصر لقطة', hint_strict: 'أقل القطعات الخاطئة؛ قد يفوّت القطع بين لقطات متشابهة.', hint_camera: 'الإعداد الافتراضي في تطبيق Life2Film: القطع قفزة في اللون والسطوع.', hint_edited: 'يجب أن يبرز القطع عن الثواني المحيطة. الأفضل للفيديو المحرَّر؛ يجد القليل في لقطة واحدة متصلة.' },
  tr: { watch: 'İzle', download: 'İndir', fullscreen: 'Tam ekran', method: 'Dedektör', strict: 'Katı — iki dedektör hemfikir', camera: 'Kamera çekimi — renk değişimi', edited: 'Kurgulanmış video — film, reklam, klip', sensitivity: 'Hassasiyet', minShot: 'En kısa çekim', hint_strict: 'En az yanlış kesme; benzer çekimler arasındaki kesmeleri kaçırabilir.', hint_camera: 'Life2Film uygulamasının varsayılanı: kesme, renk ve parlaklıkta bir sıçramadır.', hint_edited: 'Kesme, çevresindeki saniyelerden belirgin olmalı. Kurgulanmış video için en iyisi; tek kesintisiz çekimde az bulur.' },
};
const tune = TUNE[lang];

/**
 * The scene-detector interface: markup and behaviour, with no page metadata.
 *
 * Separated from the page so the localised routes can render exactly the same tool. The
 * words around it come from the registry; this is the part that does the work.
 */
---

<div class="tool" slot="tool">
          <span id="sceneI18n" data-strings={JSON.stringify(tune)} hidden></span>
          <label class="drop" id="drop" for="file">
            <input type="file" id="file" accept="video/*" hidden />
            <strong>{chrome.chooseVideo}</strong>
            <span class="muted">{chrome.dragHint} — MP4, MOV (H.264), WebM</span>
          </label>

          <div id="status" class="status" hidden>
            <div class="bar"><span id="fill"></span></div>
            <div class="statustext" id="statusText"></div>
          </div>

          <div id="result" class="result" hidden>
            <div class="readout">
              <div class="count">
                <span id="shots">—</span>
                <em>SHOTS</em>
              </div>
              <div class="meta">
                <div><span id="duration">0:00</span> long</div>
                <div><span id="average">0:00</span> average shot</div>
                <div class="muted" id="sampling"></div>
              </div>

              <div class="export">
                <select id="format" aria-label="Export format">
                  <option value="edl">EDL — DaVinci Resolve, Premiere</option>
                  <option value="otio">OTIO — Resolve, Avid, Premiere</option>
                  <option value="fcpxml">FCPXML — Final Cut Pro</option>
                  <option value="labels">Labels — Audacity</option>
                  <option value="csv">CSV — spreadsheets</option>
                  <option value="json">JSON — scripts</option>
                </select>
                <button id="save" type="button" class="ghost primary">Download</button>
                <label class="fps">
                  <span class="muted">fps</span>
                  <select id="fps" aria-label="Frame rate for timecode">
                    <option>23.976</option>
                    <option>24</option>
                    <option selected>25</option>
                    <option>29.97</option>
                    <option>30</option>
                    <option>50</option>
                    <option>60</option>
                  </select>
                </label>
              </div>
            </div>

            <div class="tune">
              <label>
                <span class="muted">{tune.method}</span>
                <select id="method">
                  <option value="edited" selected>{tune.edited}</option>
                  <option value="camera">{tune.camera}</option>
                  <option value="strict">{tune.strict}</option>
                </select>
              </label>
              <label>
                <span class="muted">{tune.sensitivity} <output id="sensValue">50%</output></span>
                <input id="sensitivity" type="range" min="0" max="1" step="0.05" value="0.5" />
              </label>
              <label>
                <span class="muted">{tune.minShot}</span>
                <select id="minShot">
                  <option value="0.3">0.3 s</option>
                  <option value="0.6" selected>0.6 s</option>
                  <option value="1">1 s</option>
                  <option value="2">2 s</option>
                  <option value="4">4 s</option>
                </select>
              </label>
              <p class="muted hint" id="methodHint"></p>
            </div>

            <div class="shots" id="shotGrid"></div>

            <div class="viewer" id="viewer" hidden role="dialog" aria-modal="true" aria-labelledby="viewerTitle">
              <div class="frame">
                <div class="vbar">
                  <span id="viewerTitle"></span>
                  <button type="button" class="ghost" id="viewerClose" aria-label="Close">✕</button>
                </div>
                <video id="viewerVideo" playsinline controls></video>
                <div class="vbar">
                  <button type="button" class="ghost" id="viewerPrev">←</button>
                  <button type="button" class="ghost" id="viewerNext">→</button>
                  <button type="button" class="ghost" id="viewerFull">{tune.fullscreen}</button>
                  <button type="button" class="ghost primary" id="viewerGet">{tune.download}</button>
                </div>
              </div>
            </div>
          </div>
        </div>

  {lang === 'en' && (
  <Fragment slot="prose">
        <h2>What a cut looks like to a machine</h2>
        <p>
          Within a single shot, consecutive frames resemble each other: the camera moves, people
          move, light shifts, but the change is gradual. At a cut, everything changes at once, the
          colour of the picture, its brightness, its structure, all in the space of one frame.
        </p>
        <p>
          So shot detection is the search for discontinuities in an otherwise continuous signal. The
          hard part is not spotting the jump; it is not mistaking a whip-pan, a flash or a fast
          dissolve for one. That is why the boundaries here come with thumbnails: the fastest way to
          check a shot list is to look at it.
        </p>

        <h2>Why it runs on your machine</h2>
        <p>
          Video is heavy. Uploading a gigabyte to answer a question about where the cuts are means
          waiting on the upload, paying for the transcode and handing the footage over, for an
          analysis that reads a few hundred small frames.
        </p>
        <p>
          The engine behind <a href="/">Life2Film</a> was built to run on a phone, so it is small
          enough to run in a tab. The browser already has a video decoder; this page uses it, hands
          the pixels to the same Rust the app uses, compiled to WebAssembly, and never opens a
          socket.
        </p>
        <p>
          The <a href="/tools/bpm-detector/">BPM detector</a> is the same engine looking at sound
          instead of pictures.
        </p>
    </Fragment>
)}
{/* Global: the cards are built with innerHTML, so they never get Astro's scoping attribute and
    scoped rules never matched them. Only this tool's CSS loads on its page. */}
<style is:global>

    .result { margin-top: 20px; }
    .readout { display: flex; flex-wrap: wrap; gap: 28px; align-items: center; margin-bottom: 20px; }
    .count { display: flex; align-items: baseline; gap: 10px; }
    .count span {
      font-size: 56px; font-weight: 700; letter-spacing: -0.04em; line-height: 1;
      background: var(--grad); -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .count em { font-style: normal; font-size: 13px; color: var(--muted); letter-spacing: .1em; }
    .meta { font-size: 15px; color: #cfcfd6; display: grid; gap: 2px; }

    .export { display: flex; gap: 8px; align-items: center; margin-left: auto; flex-wrap: wrap; }
    .fps { display: flex; gap: 6px; align-items: center; font-size: 13px; }
    .tool select {
      padding: 9px 12px; border-radius: 10px; font: inherit; font-size: 14px; cursor: pointer;
      color: var(--fg); background: #0a0a0d; border: 1px solid var(--line);
    }
    .tool select:hover { border-color: var(--cyan); }
    .fps select { padding: 7px 8px; font-size: 13px; }

    .tune { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: flex-end; margin: 0 0 18px; padding: 14px; border: 1px solid var(--line); border-radius: 12px; }
    .tune label { display: grid; gap: 6px; font-size: 13px; min-width: 0; }
    .tune input[type=range] { width: 180px; accent-color: var(--cyan); }
    .tune .hint { flex-basis: 100%; margin: 0; font-size: 13px; }
    .tune select { max-width: 100%; }
    .shots { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(158px, 1fr)); }
    .shot {
      border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: #08080a;
    }
    .shot img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: #111; }
    .shot .info { padding: 8px 10px; display: grid; gap: 2px; }
    .shot .thumb { position: relative; display: block; width: 100%; padding: 0; border: 0; background: none; cursor: pointer; }
    .shot .thumb .play { position: absolute; inset: 0; display: grid; place-items: center; font-size: 26px; color: #fff; opacity: 0; transition: opacity .15s; background: rgba(0,0,0,.35); }
    .shot .thumb:hover .play, .shot .thumb:focus-visible .play { opacity: 1; }
    .shot .acts { display: flex; gap: 6px; margin-top: 6px; }
    .shot .acts button { padding: 4px 8px; font-size: 12px; }
    .viewer { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; padding: 16px; background: rgba(0,0,0,.94); }
    .viewer[hidden] { display: none; }
    .viewer .frame { width: min(1100px, 100%); display: grid; gap: 10px; }
    .viewer video { width: 100%; max-height: calc(100dvh - 140px); background: #000; border-radius: 10px; }
    .viewer .vbar { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; color: #ddd; font-size: 14px; }
    .viewer .vbar #viewerTitle { margin-right: auto; font-family: ui-monospace, monospace; }
    .shot .tc { font-size: 13px; font-family: ui-monospace, monospace; }
    .shot .len { font-size: 12px; color: var(--muted); }
    .shot .score { height: 3px; border-radius: 2px; background: #17171c; margin-top: 4px; }
    .shot .score span { display: block; height: 100%; background: var(--grad); }
</style>

<script>
    import { fileChosen, toolFailed, track } from '../../lib/track';
    import type { Shot } from '../../lib/clips';
    import { loadEngine, loadFullEngine } from '../../lib/engine';
    import { encode, saveBlob } from '../../lib/encode';
    import { contentWidth, hsvDelta, toHsv, type ContentDelta } from '../../lib/content-delta';
    import { openVideo, samplePlan, centerPixel, refineBoundary, type VideoSource } from '../../lib/frames';
    import { detectShots, type ShotInput, type ShotMethod, type ShotOptions } from '../../lib/shots';
    import { clock, timecode, render, download, EXTENSION, type Format, type Mark } from '../../lib/timeline-export';

    const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    const drop = el<HTMLLabelElement>('drop');
    const fileInput = el<HTMLInputElement>('file');
    const statusEl = el<HTMLDivElement>('status');
    const resultEl = el<HTMLDivElement>('result');
    const grid = el<HTMLDivElement>('shotGrid');

    // Frames are analysed at 64 px wide — the same size the desktop pipeline uses. Scene changes
    // are large-scale events; a bigger frame costs time and finds the same cuts.
    const ANALYSIS_WIDTH = 64;
    const THUMB_WIDTH = 320;

    // AI-NOTE: no length limit. Until 27 Nov 2026 anything past 10 minutes was refused — half the
    // tool's failures that week (films of 23, 78 and 119 minutes) — although `samplePlan` already
    // capped the seeks at 500 whatever the length. Long videos get one sample a second (at most
    // LONG_MAX_SAMPLES), and past REFINE_LIMIT cuts the per-cut refinement (~20 seeks each) is
    // skipped and the precision is said instead.
    // Denser sampling does not help: 4/s on a 9-minute real-footage test raised the column
    // detector's false cuts from 6 to 74 and the agreed cuts fell from 12 to 10 (27 Nov 2026).
    const LONG_AFTER_S = 600;
    const LONG_MAX_SAMPLES = 2000;
    const REFINE_LIMIT = 150;
    // The colour detectors' density: the core's CLI decodes them at 5 fps; 4 is the browser's budget.
    const CONTENT_PER_S = 4;
    const CONTENT_MAX_SAMPLES = 4000;


    let shots: Shot[] = [];
    let videoDuration = 0;
    let fileName = 'video';

    // What one read of the video measured: every knob re-detects from this without reading again.
    interface Measured {
      source: VideoSource;
      file: File;
      /** Object URL of the file for the shot viewer; revoked with the next file. */
      url: string;
      input: ShotInput;
      scores: Array<{ timestamp: number; score: number }>;
      coarseStep: number;
      samples: number;
      startedAt: number;
    }
    let measured: Measured | null = null;
    // Bumped by every detection; a thumbnail loop from an older one stops when it sees a newer number.
    let generation = 0;

    const TXT = JSON.parse(el('sceneI18n').dataset.strings ?? '{}') as Record<string, string>;
    const T = (key: string, vars: Record<string, string> = {}) =>
      (TXT[key] ?? key).replace(/\{(\w+)\}/g, (_, k: string) => vars[k] ?? '');

    const methodEl = el<HTMLSelectElement>('method');
    const sensEl = el<HTMLInputElement>('sensitivity');
    const minEl = el<HTMLSelectElement>('minShot');
    const options = (): ShotOptions => ({
      method: (methodEl.value as ShotMethod) || 'edited',
      sensitivity: Number(sensEl.value),
      minShot: Number(minEl.value) || 0.6,
    });

    function status(message: string, fraction?: number, isError = false) {
      statusEl.hidden = false;
      statusEl.classList.toggle('err', isError);
      el('statusText').textContent = message;
      if (fraction !== undefined) {
        el('fill').style.width = `${Math.round(fraction * 100)}%`;
      }
    }

    let busy = false;

    async function analyse(file: File) {
      // Two drops used to run two analyses on the same module state and one grid.
      if (busy) return;
      busy = true;
      fileName = file.name.replace(/\.[^.]+$/, '') || 'video';
      resultEl.hidden = true;
      grid.replaceChildren();
      generation++;
      measured?.source.release();
      if (measured) URL.revokeObjectURL(measured.url);
      measured = null;
      closeViewer();
      status('Opening video…', 0);

      let source: VideoSource | null = null;
      const startedAt = performance.now();

      try {
        source = await openVideo(file);
        videoDuration = source.duration;

        const engine = await loadEngine();
        // Two densities from one read. The colour detectors want neighbouring samples close
        // together (CONTENT_PER_S); the strict pair gets every `stride`-th sample, its old density
        // (500 samples, or one a second past 10 minutes) — denser made it worse.
        const long = source.duration > LONG_AFTER_S;
        const strictCount = long
          ? Math.min(LONG_MAX_SAMPLES, Math.ceil(source.duration))
          : Math.min(500, Math.max(2, Math.ceil(source.duration * 10)));
        const plan = samplePlan(source.duration, Math.max(strictCount, Math.min(CONTENT_MAX_SAMPLES, Math.ceil(source.duration * CONTENT_PER_S))));
        const stride = Math.max(1, Math.round(plan.length / strictCount));
        const coarseStep = (source.duration / plan.length) * stride;
        const cw = contentWidth(source.width, source.height);

        const pixels: Array<{ r: number; g: number; b: number }> = [];
        const timestamps: number[] = [];
        const scores: Array<{ timestamp: number; score: number }> = [];
        const vectors: number[][] = [];
        const deltas: ContentDelta[] = [];
        let prevHsv: Uint8Array | null = null;

        for (const [i, at] of plan.entries()) {
          // The 120 px read goes first. Read after the 64 px one it changed what the 64 px read saw on
          // the next sample: strict found 5 cuts on the 9-minute test instead of 12 (27 Nov 2026).
          const contentRgb = (await source.frameAt(at, cw)).rgb24;
          if (i % stride === 0) {
            const frame = await source.frameAt(at, ANALYSIS_WIDTH);
            pixels.push(centerPixel(frame));
            timestamps.push(at);

            const scored = JSON.parse(
              engine.score_frame(frame.width, frame.height, frame.rgb24, at, null),
            ) as { score?: number; vector?: number[]; error?: string };
            if (!scored.error) scores.push({ timestamp: at, score: scored.score ?? 0 });
            // The same measurements feed the second detector; a frame the scorer refused gets a zero
            // vector so the two series stay aligned with `timestamps`.
            vectors.push(scored.vector ?? []);
          }

          // The colour delta the `content` / `adaptive` detectors read, at the core's 120 px short
          // side; the same instant, so no second seek.
          const hsv = toHsv(contentRgb);
          if (prevHsv) {
            const d = hsvDelta(prevHsv, hsv, at);
            if (d) deltas.push(d);
          }
          prevHsv = hsv;

          // Reading every sample is the slow part, so the bar tracks it rather than the analysis.
          if (i % 4 === 0) {
            status(`Reading frames — ${i + 1} of ${plan.length}`, (i + 1) / plan.length * 0.9);
          }
        }

        measured = {
          source,
          file,
          url: URL.createObjectURL(file),
          input: { pixels, vectors, timestamps, duration: source.duration, deltas },
          scores,
          coarseStep,
          samples: plan.length,
          startedAt,
        };
        source = null; // owned by `measured` now, released by the next file
        await detect(true);
      } catch (error) {
        toolFailed('analyse', error, file);
        status(
          error instanceof Error ? error.message : 'Something went wrong reading that file.',
          1,
          true,
        );
      } finally {
        source?.release();
        busy = false;
      }
    }

    /** Cuts from what was measured, with the knobs as they are now. */
    async function detect(first = false) {
      const m = measured;
      if (!m) return;
      const mine = ++generation;
      const opts = options();
      const engine = opts.method === 'strict' ? await loadEngine() : await loadFullEngine();
      if (mine !== generation) return;

      status('Finding the cuts…', 0.93);
      const ranges = detectShots(engine, m.input, opts);

      // Second pass: the coarse grid can only say which sample the picture changed by, so each
      // boundary is re-examined by `refineBoundary` — a wide pass at the coarse step, bounded by
      // the midpoints to the neighbouring cuts, then a fine pass at a tenth of it. It is what
      // moves the reported cut from "about right" to "on the frame".
      const boundaries = ranges.slice(1).map(([start]) => start);
      const refined = new Map<number, number>();
      // Only the strict pair is refined: the refinement reads the centre column, the weak signal, and
      // on the colour detectors' cuts (already on a 0.25 s grid) it moved right cuts to wrong frames —
      // content at 13 scored F1 0.24 refined against the core's 0.82 unrefined (27 Nov 2026).
      const strict = opts.method === 'strict';
      const step = strict ? m.coarseStep : m.input.duration / m.samples;
      const refine = strict && boundaries.length <= REFINE_LIMIT;
      el('sampling').textContent =
        `${strict ? m.input.timestamps.length : m.samples} samples · ${(1 / step).toFixed(1)} per second` +
        (refine ? '' : ` · cuts within ±${(step / 2).toFixed(2)} s`);

      for (const [i, boundary] of (refine ? boundaries : []).entries()) {
        if (mine !== generation) return;
        status(`Refining cut ${i + 1} of ${boundaries.length}…`, 0.93 + (i / boundaries.length) * 0.06);
        refined.set(boundary, await refineBoundary(m.source, boundary, m.coarseStep, ANALYSIS_WIDTH, {
          previous: boundaries[i - 1] ?? 0,
          next: boundaries[i + 1] ?? m.input.duration,
        }));
      }
      if (mine !== generation) return;

      shots = ranges.map(([start, end]) => {
        const movedStart = refined.get(start) ?? start;
        const movedEnd = refined.get(end) ?? end;
        return [movedStart, movedEnd] as [number, number];
      }).map(([start, end]) => {
        // Median score of the samples inside the shot — a mean would let one bad frame sink it.
        const inside = m.scores.filter((s) => s.timestamp >= start && s.timestamp < end).map((s) => s.score);
        inside.sort((a, b) => a - b);
        return {
          start,
          end,
          score: inside.length ? inside[Math.floor(inside.length / 2)] : 0,
        };
      });

      el('shots').textContent = String(shots.length);
      el('duration').textContent = clock(m.input.duration);
      el('average').textContent = clock(m.input.duration / shots.length);
      el('methodHint').textContent = T(`hint_${opts.method}`);

      statusEl.hidden = true;
      resultEl.hidden = false;
      grid.replaceChildren();
      track(first ? 'result_shown' : 'tool_tuned', {
        placement: 'result', refined: refine ? 'yes' : 'no', method: opts.method,
      }, {
        shots: shots.length,
        duration_s: Math.round(m.input.duration),
        samples: m.samples,
        seconds: Math.round((performance.now() - m.startedAt) / 1000),
        sensitivity: opts.sensitivity,
        min_shot: opts.minShot,
      });

      // Thumbnails come last, from a second pass over shot starts only — a few dozen seeks rather
      // than a few hundred, so the numbers appear before the pictures do.
      await renderShots(m.source, mine);
    }

    let tuneTimer: ReturnType<typeof setTimeout> | undefined;
    const retune = () => {
      clearTimeout(tuneTimer);
      el('sensValue').textContent = `${Math.round(Number(sensEl.value) * 100)}%`;
      tuneTimer = setTimeout(() => {
        void detect().catch((error: unknown) => {
          toolFailed('analyse', error);
          status(error instanceof Error ? error.message : String(error), 1, true);
        });
      }, 200);
    };
    methodEl.addEventListener('change', retune);
    sensEl.addEventListener('input', retune);
    minEl.addEventListener('change', retune);

    async function renderShots(source: VideoSource, mine: number) {
      const rate = fps();
      const highest = Math.max(...shots.map((s) => s.score), 1);

      for (const [i, shot] of shots.entries()) {
        if (mine !== generation) return;
        const card = document.createElement('div');
        card.className = 'shot';
        card.innerHTML = `
          <button type="button" class="thumb" data-view="${i}" aria-label="${T('watch')} ${i + 1}"><img alt="Shot ${i + 1}" loading="lazy" /><span class="play">▶</span></button>
          <div class="info">
            <span class="tc">${timecode(shot.start, rate)}</span>
            <span class="len">Shot ${i + 1} · ${(shot.end - shot.start).toFixed(1)}s</span>
            <span class="score"><span style="width:${Math.round((shot.score / highest) * 100)}%"></span></span>
            <span class="acts"><button type="button" class="ghost" data-view="${i}">${T('watch')}</button><button type="button" class="ghost" data-get="${i}">${T('download')}</button></span>
          </div>`;
        grid.append(card);

        // A shot's first frame is often mid-transition; a moment in gives a truer picture.
        const at = Math.min(shot.start + 0.25, shot.end - 0.05, source.duration - 0.05);
        try {
          card.querySelector('img')!.src = await source.thumbnailAt(Math.max(0, at), THUMB_WIDTH);
        } catch {
          // A thumbnail that will not render does not invalidate the cut it belongs to.
        }
      }
    }

    const fps = () => Number(el<HTMLSelectElement>('fps').value) || 25;

    // --- input ---

    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) { fileChosen(file, 'picker'); void analyse(file); }
    });

    for (const type of ['dragenter', 'dragover']) {
      drop.addEventListener(type, (e) => {
        e.preventDefault();
        drop.classList.add('over');
      });
    }
    for (const type of ['dragleave', 'drop']) {
      drop.addEventListener(type, (e) => {
        e.preventDefault();
        drop.classList.remove('over');
      });
    }
    drop.addEventListener('drop', (e) => {
      const file = (e as DragEvent).dataTransfer?.files?.[0];
      if (file) { fileChosen(file, 'drop'); void analyse(file); }
    });

    // --- one shot: watch it (full screen too) or download it as its own MP4 ---

    const viewer = el<HTMLDivElement>('viewer');
    // Moved to <body>: an ancestor of the tool makes a containing block for `position: fixed`, which
    // left the overlay boxed inside the page under the site header.
    document.body.append(viewer);
    const player = el<HTMLVideoElement>('viewerVideo');
    let viewing = -1;

    function closeViewer() {
      if (viewing < 0) return;
      viewing = -1;
      player.pause();
      player.removeAttribute('src');
      player.load();
      viewer.hidden = true;
      if (document.fullscreenElement) void document.exitFullscreen().catch(() => {});
    }

    function openViewer(i: number) {
      const m = measured;
      const shot = shots[i];
      if (!m || !shot) return;
      viewing = i;
      viewer.hidden = false;
      el('viewerTitle').textContent = `#${i + 1} / ${shots.length} · ${timecode(shot.start, fps())} · ${(shot.end - shot.start).toFixed(1)}s`;
      if (player.getAttribute('src') !== m.url) player.src = m.url;
      player.currentTime = shot.start;
      void player.play().catch(() => {});
      track('shot_viewed', { placement: 'result' }, { shot: i + 1 });
    }

    // The shot loops inside its own bounds rather than running on into the next one.
    player.addEventListener('timeupdate', () => {
      const shot = shots[viewing];
      if (shot && player.currentTime >= shot.end - 0.04) player.currentTime = shot.start;
    });

    async function downloadShot(i: number) {
      const m = measured;
      const shot = shots[i];
      if (!m || !shot) return;
      const button = grid.querySelector<HTMLButtonElement>(`[data-get="${i}"]`);
      const label = button?.textContent ?? '';
      try {
        // Re-encoded from the exact in-point (a copied cut could only start on a keyframe); the
        // same `encode` the splitter saves its clips through.
        const blob = await encode(m.file, {
          container: 'mp4',
          trim: { start: shot.start, end: shot.end },
          forceTranscode: true,
          onProgress: (p) => { if (button) button.textContent = `${Math.round(p * 100)}%`; },
        });
        saveBlob(blob, `${fileName}-shot-${i + 1}.mp4`);
        track('result_saved', { placement: 'shot', format: 'mp4', method: options().method }, { shot: i + 1, seconds: Math.round(shot.end - shot.start) });
      } catch (error) {
        toolFailed('save', error, m.file);
        status(error instanceof Error ? error.message : String(error), 1, true);
      } finally {
        if (button) button.textContent = label;
      }
    }

    grid.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-view],[data-get]');
      if (!t) return;
      if (t.dataset.view !== undefined) openViewer(Number(t.dataset.view));
      else void downloadShot(Number(t.dataset.get));
    });
    el('viewerClose').addEventListener('click', closeViewer);
    el('viewerPrev').addEventListener('click', () => openViewer(Math.max(0, viewing - 1)));
    el('viewerNext').addEventListener('click', () => openViewer(Math.min(shots.length - 1, viewing + 1)));
    el('viewerGet').addEventListener('click', () => { if (viewing >= 0) void downloadShot(viewing); });
    el('viewerFull').addEventListener('click', () => { void player.requestFullscreen?.().catch(() => {}); });
    viewer.addEventListener('click', (e) => { if (e.target === viewer) closeViewer(); });
    addEventListener('keydown', (e) => {
      if (viewing < 0) return;
      if (e.key === 'Escape') closeViewer();
      else if (e.key === 'ArrowLeft') openViewer(Math.max(0, viewing - 1));
      else if (e.key === 'ArrowRight') openViewer(Math.min(shots.length - 1, viewing + 1));
    });

    // --- export ---

    el<HTMLButtonElement>('save').addEventListener('click', () => {
      if (!shots.length) return;
      const format = el<HTMLSelectElement>('format').value as Format;
      const rate = fps();

      const marks: Mark[] = shots.map((shot, i) => ({
        start: shot.start,
        end: shot.end,
        name: `Shot ${i + 1}`,
      }));

      download(
        render(format, marks, {
          title: `${fileName} shots`,
          rate,
          duration: videoDuration,
          metadata: { shots: shots.length },
        }),
        `${fileName}-shots.${EXTENSION[format]}`,
      );
      const o = options();
      track('result_saved', { placement: 'result', format, method: o.method }, { shots: shots.length, sensitivity: o.sensitivity, min_shot: o.minShot });
    });
</script>
