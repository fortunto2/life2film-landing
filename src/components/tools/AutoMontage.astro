---
import { CHROME, STATUS } from '../../lib/tools-i18n';
import type { Lang } from '../../i18n';
import { localePath } from '../../i18n';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const chrome = CHROME[lang];
const status = STATUS[lang];

const WORDS: Partial<Record<Lang, Record<string, string>>> = {
  en: { clips: 'Your clips (up to 10)', song: 'The song', songHint: 'MP3, M4A or WAV — the cuts land on its beats', length: 'Length', shape: 'Shape', auto: 'Like the clips', run: 'Make the montage', engine: 'Loading the montage engine (1.3 MB, once)…', analyze: 'Watching the clips… {n}%', music: 'Finding the beats…', render: 'Cutting to the beat… {n}%', saved: 'Saved — {shots} cuts from {clips} clips at {bpm} BPM, {len}, {size}.', needSong: 'Add a song first.', failed: 'Could not make it — {msg}', app: 'Want it in 4K, with titles and your photos? The Life2Film app does the same montage on your iPhone.', editor: 'Rather put the shots in order yourself? Open the video editor' },
  ru: { clips: 'Ваши клипы (до 10)', song: 'Песня', songHint: 'MP3, M4A или WAV — склейки встанут на её доли', length: 'Длина', shape: 'Формат', auto: 'Как у клипов', run: 'Смонтировать', engine: 'Загружаем движок монтажа (1,3 МБ, один раз)…', analyze: 'Смотрим клипы… {n}%', music: 'Ищем доли в песне…', render: 'Режем под бит… {n}%', saved: 'Сохранено — {shots} склеек из {clips} клипов, {bpm} BPM, {len}, {size}.', needSong: 'Сначала добавьте песню.', failed: 'Не получилось — {msg}', app: 'Нужно в 4K, с титрами и фото? Приложение Life2Film делает тот же монтаж на iPhone.', editor: 'Хотите расставить куски сами? Откройте видеоредактор' },
};
const words = WORDS[lang] ?? WORDS.en!;
---

<div class="tool" slot="tool">
  <span id="i18n" data-strings={JSON.stringify(status)} hidden></span>
  <span id="words" data-words={JSON.stringify(words)} hidden></span>
  <label class="drop" id="drop" for="file">
    <input type="file" id="file" accept="video/*" multiple hidden />
    <strong>{words.clips}</strong>
    <span class="muted">{chrome.dragHint} — MP4, MOV, WebM</span>
  </label>
  <label class="drop song" for="song">
    <input type="file" id="song" accept="audio/*,.mp3,.m4a,.wav" hidden />
    <strong>{words.song}</strong>
    <span class="muted" id="songName">{words.songHint}</span>
  </label>
  <div class="controls">
    <label class="control"><span class="muted">{words.length}</span>
      <select id="target"><option value="15">0:15</option><option value="30" selected>0:30</option><option value="60">1:00</option></select></label>
    <label class="control"><span class="muted">{words.shape}</span>
      <select id="shape"><option value="auto" selected>{words.auto}</option><option value="9:16">9:16</option><option value="16:9">16:9</option></select></label>
    <span class="spacer"></span>
    <button id="run" type="button" class="ghost primary" data-sda-event="tool_run" data-sda-placement="controls">{words.run}</button>
  </div>
  <div id="status" class="status" hidden>
    <div class="bar"><span id="fill"></span></div>
    <div class="statustext" id="statusText"></div>
  </div>
  <p class="muted small">{words.app}</p>
  <p class="muted small"><a class="link" href={localePath(lang, '/tools/video-editor/')}>{words.editor} →</a></p>
</div>

<style>
  .song { margin-top: 10px; padding: 14px; }
  .small { font-size: 0.85rem; }
  .link { color: var(--cyan); text-decoration: none; font-weight: 500; }
  .link:hover { text-decoration: underline; }
</style>

<script>
  import { mountTool, messageOf } from 'superduper-tools/shell';
  import { fileChosen, toolFailed, track } from '../../lib/track';
  import { saveBlob, formatBytes, preciseClock } from '../../lib/encode';
  import { autoMontage } from '../../lib/auto-montage';

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const w = JSON.parse(el('words').dataset.words ?? '{}') as Record<string, string>;
  let song: File | null = null;
  el<HTMLInputElement>('song').addEventListener('change', (e) => {
    song = (e.target as HTMLInputElement).files?.[0] ?? null;
    if (song) { el('songName').textContent = song.name; fileChosen(song, 'picker'); }
  });

  mountTool({
    multiple: true,
    onFiles: (fs, via, status) => { fs.slice(0, 1).forEach((f) => fileChosen(f, via)); status(fs.map((f) => f.name).join(', ')); },
    onError: (error, [f]) => { toolFailed('run', error, f); return w.failed.replace('{msg}', messageOf(error)); },
    run: async ({ files, status }) => {
      if (!song) { status(w.needSong, 0, true); return; }
      const clips = files.slice(0, 10);
      const target = Number(el<HTMLSelectElement>('target').value);
      const shape = el<HTMLSelectElement>('shape').value as 'auto' | '9:16' | '16:9';
      const pct = (f: number) => String(Math.round(f * 100));
      const r = await autoMontage(clips, song, target, shape, (stage, f) => {
        if (stage === 'engine') status(w.engine, 0.02);
        else if (stage === 'analyze') status(w.analyze.replace('{n}', pct(f)), 0.05 + f * 0.4);
        else if (stage === 'music') status(w.music, 0.47);
        else status(w.render.replace('{n}', pct(f)), 0.5 + f * 0.48);
      });
      saveBlob(r.blob, 'life2film-montage.mp4');
      track('result_saved', { placement: 'result', shape }, { clips: clips.length, clips_used: r.clipsUsed, shots: r.shots, seconds: Math.round(r.duration), bpm: Math.round(r.bpm) });
      status(w.saved.replace('{shots}', String(r.shots)).replace('{clips}', String(r.clipsUsed)).replace('{bpm}', String(Math.round(r.bpm))).replace('{len}', preciseClock(r.duration)).replace('{size}', formatBytes(r.blob.size)), 1);
    },
  });
</script>
