---
// The original LIFE2FILM logo pattern (2018, design: MANITOU / ann.ridzel —
// codepen.io/lifefilm/pen/zgKWMa), restored from startups/old/patterndemo and
// extended with the app's calendar ring.
//
// Since 19 Oct 2026 the fourteen rings are a Rive file, `public/rive/wheel.riv`,
// generated by `rive/wheel/gen.py` from the same radii, dashes and gradients that
// used to be SVG + SMIL here. Why: SMIL rotation of fourteen circles never stops,
// even off-screen, and was the one thing in the hero burning a phone's battery; the
// canvas pauses when scrolled away, holds still under Reduce Motion (the file's
// `still` property), and the same 4 KB file can be drawn by the iOS app through
// RiveRuntime. The month ring and its labels stay SVG on top: they are text, and
// text in Rive needs a font asset.
//
// Until the runtime loads — or if it never does — `public/img/wheel.png` (rendered
// from the same file by the build) stands in, so nothing depends on JavaScript.
const months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
// Months with footage — the wheel's whole point.
const active = new Set([1, 4, 5, 6, 9]);
const MONTH_R = 1850;
---

<div class="wheel" data-rive="/rive/wheel.riv">
  <img class="rings poster" src="/img/wheel.png" width="400" height="400" alt="" decoding="async" />
  <canvas class="rings live" width="400" height="400" hidden aria-hidden="true"></canvas>

  <svg viewBox="-2000 -2000 4000 4000" preserveAspectRatio="xMidYMid meet" role="img"
       aria-label="Life2Film calendar wheel">
    <g class="months" aria-hidden="true">
      {months.map((m, i) => {
        const a = ((i / 12) * 360 - 90) * (Math.PI / 180);
        const seg = (d: number) => (((i / 12) * 360 - 90 + d) * Math.PI) / 180;
        return (
          <>
            <path
              d={`M ${Math.cos(seg(-11)) * 1760} ${Math.sin(seg(-11)) * 1760}
                  A 1760 1760 0 0 1 ${Math.cos(seg(11)) * 1760} ${Math.sin(seg(11)) * 1760}`}
              fill="none"
              stroke={active.has(i) ? 'url(#paint2)' : '#26262e'}
              stroke-width={active.has(i) ? 34 : 16}
              stroke-linecap="round"
            />
            <text
              x={Math.cos(a) * MONTH_R}
              y={Math.sin(a) * MONTH_R}
              text-anchor="middle"
              dominant-baseline="middle"
              class={active.has(i) ? 'month on' : 'month'}
            >{m}</text>
          </>
        );
      })}
    </g>

    <defs>
      <linearGradient id="paint2" x1="100%" y1="0%" x2="0%" y2="100%">
        <stop offset="0" stop-color="#00F2E0" />
        <stop offset="10%" stop-color="#017AFF" />
        <stop offset="50%" stop-color="#FA3FA5" />
        <stop offset="90%" stop-color="#FFA61D" />
        <stop offset="100%" stop-color="#FEFF00" />
      </linearGradient>
    </defs>
  </svg>
</div>

<script>
  // The runtime — 57 KB of JS plus 325 KB of wasm, gzipped, measured 19 Oct 2026 — is
  // fetched only once the wheel is near the viewport; the poster shows until the first
  // frame is drawn. Off-screen the machine is paused, and Reduce Motion is written into
  // the file's `still` property, live. The wasm is served from /rive/ (rive/build.sh
  // copies it): left alone, the runtime loads it from unpkg.com, one more host handed
  // the visitor's IP for a decoration. (The page already reaches Google for fonts and
  // gtag — measured 19 Oct 2026 — which is a separate question, not a licence.)
  import type { Rive as RiveType } from '@rive-app/canvas-lite';

  const wheel = document.querySelector<HTMLElement>('.wheel[data-rive]');
  const canvas = wheel?.querySelector<HTMLCanvasElement>('canvas.live');
  const poster = wheel?.querySelector<HTMLImageElement>('img.poster');

  if (wheel && canvas && poster) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let started = false;

    const start = async () => {
      started = true;
      const { Rive, Layout, Fit, RuntimeLoader } = await import('@rive-app/canvas-lite');
      RuntimeLoader.setWasmUrl('/rive/rive.wasm');
      let rive: RiveType | undefined;
      const applyStill = () => {
        const still = rive?.viewModelInstance?.boolean('still');
        if (still) still.value = reduced.matches;
      };
      rive = new Rive({
        src: wheel.dataset.rive!,
        canvas,
        autoplay: true,
        stateMachines: 'Main',
        autoBind: true,
        layout: new Layout({ fit: Fit.Contain }),
        onLoad: () => {
          rive?.resizeDrawingSurfaceToCanvas();
          canvas.hidden = false;
          poster.hidden = true;
          applyStill();
        },
      });
      reduced.addEventListener('change', applyStill);
      addEventListener('resize', () => rive?.resizeDrawingSurfaceToCanvas(), { passive: true });
      new IntersectionObserver(
        (entries) => { for (const e of entries) e.isIntersecting ? rive?.play() : rive?.pause(); },
        { threshold: 0.05 },
      ).observe(canvas);
    };

    new IntersectionObserver(
      (entries, io) => {
        if (started || !entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        start().catch(() => { /* the poster stays */ });
      },
      { rootMargin: '240px' },
    ).observe(wheel);
  }
</script>

<style>
  .wheel { position: relative; width: min(560px, 92vw); margin-inline: auto; }
  .wheel svg { position: relative; width: 100%; height: auto; display: block; pointer-events: none; }
  /* The artboard is 400 × 400 for the SVG's 4000 × 4000 viewBox: the same box, one tenth
     the units, so both layers share the centre and the scale exactly. */
  .rings { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .rings[hidden] { display: none; }

  .month {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 108px;
    font-weight: 500;
    letter-spacing: 0.08em;
    fill: #8a8a95;
  }
  .month.on { fill: #f2f2f4; }
</style>
