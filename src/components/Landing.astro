---
import CalendarWheel from './CalendarWheel.astro';
import { localePath, useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [
  { t: t('h1t'), d: t('h1d') },
  { t: t('h2t'), d: t('h2d') },
  { t: t('h3t'), d: t('h3d') },
];
const feats = [
  { t: t('f1t'), d: t('f1d') },
  { t: t('f2t'), d: t('f2d') },
  { t: t('f3t'), d: t('f3d') },
  { t: t('f4t'), d: t('f4d') },
];
---

<main>
  {/*
    Design pass 3 Nov 2026: one headline, one line, one button, one proof line. The pill
    eyebrow, the account note and the Mac note went; Mac is a text link beside the button.
    The right half shows the app itself (the calendar wheel screen), static: the beach film
    stays out until there is a better cut.
  */}
  <section class="hero">
    <div class="wrap herogrid">
      <div class="herotext">
        <h1 set:html={t('heroTitle')} />
        <p class="lede">{t('heroLede')}</p>
        <div class="cta">
          {/*
            Единственное звено между сайтом и приложением, и до сих пор оно не считалось ни с
            одной стороны. Теперь считается с обеих, и намеренно РАЗНЫМИ счётчиками:

            `ct` — токен кампании Apple. App Store Connect привязывает к нему показы страницы,
            установки и покупки; `pt` — идентификатор провайдера. Токен помечает ИСТОЧНИК, а не
            человека, поэтому связь остаётся агрегатной и не требует сквозного идентификатора.

            `data-sda-event` — наш клик. Общий сниппет ловит атрибут сам, так что на сайте не
            появляется ни строки JS. Клик и установка НЕ складываются: их считают разные
            стороны, и сходятся они только по имени токена.

            Имя места одно на обе разметки — `site-hero`: порознь они разъезжаются на первой же
            новой кнопке, и тогда «сколько установок дал герой» перестаёт иметь ответ.
          */}
          <a
            class="btn btn-store"
            href="https://apps.apple.com/app/id6761656888?pt=128499174&ct=site-hero&mt=8"
            target="_blank"
            rel="noopener"
            data-sda-event="app_store_opened"
            data-sda-placement="site-hero"
          >
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
              <path d="M11.18 0c.08.9-.28 1.78-.83 2.42-.55.64-1.44 1.13-2.31 1.06-.1-.86.32-1.77.85-2.34C9.44.48 10.4.04 11.18 0zm2.7 5.44c-.05.03-1.63.94-1.61 2.8.02 2.23 1.95 2.97 1.98 2.98-.02.06-.31 1.06-1.02 2.09-.61.9-1.25 1.8-2.26 1.82-.99.02-1.31-.59-2.44-.59-1.13 0-1.48.57-2.42.6-.97.04-1.71-.97-2.33-1.87C2.5 11.44 1.53 8.1 2.83 5.84c.64-1.12 1.8-1.83 3.05-1.85.95-.02 1.85.64 2.43.64.58 0 1.67-.79 2.82-.68.48.02 1.83.19 2.7 1.45z"/>
            </svg>
            {t('ctaPrimary')}
          </a>
          <a href="/studio/" class="maclink" data-sda-event="studio_opened" data-sda-placement="site-hero">{t('macCta')} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <p class="proof">{t('heroProof')}</p>
      </div>

      <figure class="heroshot">
        <div class="phone">
          <img src="/img/shot-01.jpg" alt={t('s1')} width="620" height="1280" loading="eager" fetchpriority="high" decoding="async" />
        </div>
      </figure>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{t('howTitle')}</h2>
      {/* The wheel moved here from the hero: beside «pick a stretch of time» it explains
          something; in the hero it was a logo where the film should be. */}
      <div class="howgrid">
        <div class="howwheel" aria-hidden="true"><CalendarWheel /></div>
        <div class="steps">
          {steps.map((s, i) => (
            <div class="card">
              <span class="num gradient-text">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{t('featTitle')}</h2>
      <div class="feats">
        {feats.map((f) => (
          <div class="feat">
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="screens">
    <div class="wrap">
      <h2>{t('screensTitle')}</h2>
      <div class="shots">
        {[2, 3, 4].map((n) => (
          <figure>
            <img
              src={`/img/shot-0${n}.jpg`}
              alt={t(`s${n}` as 's1')}
              width="620"
              height="1280"
              loading="lazy"
              decoding="async"
            />
            <figcaption>{t(`s${n}` as 's1')}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="priv">
    <div class="wrap privwrap">
      <h2>{t('privTitle')}</h2>
      <p class="lede">{t('privLede')}</p>
      <p class="muted small">{t('privNote')} <a class="privlink" href={localePath(lang, '/privacy')}>{t('privLink')} <span class="arrow" aria-hidden="true">→</span></a></p>
    </div>
  </section>
  {/*
    Not on an iPhone: Android, and the Studio for Mac while it is a beta. One address, one
    reason, one email when it ships. POST /api/waitlist (functions/api/waitlist.js) keeps
    sha256(address) → {reason, lang}; the form works without JavaScript (303 back here)
    and with it (fetch, no reload). The count goes through the empty <i> on success only.
  */}
  <section class="wait" id="waitlist">
    <div class="wrap waitwrap">
      <h2>{t('waitTitle')}</h2>
      <p class="muted">{t('waitLede')}</p>
      <form class="waitform" method="post" action="/api/waitlist" data-done={t('waitDone')} data-fail={t('waitFail')}>
        <input type="hidden" name="lang" value={lang} />
        <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="reasons" role="radiogroup" aria-label={t('waitTitle')}>
          <label class="reason"><input type="radio" name="reason" value="android" checked /><span>{t('waitAndroid')}</span></label>
          <label class="reason"><input type="radio" name="reason" value="studio" /><span>{t('waitStudio')}</span></label>
        </div>
        <div class="waitrow">
          <label class="sr-only" for="wait-email">{t('waitEmail')}</label>
          <input id="wait-email" type="email" name="email" required autocomplete="email" inputmode="email" placeholder={t('waitEmail')} />
          <button type="submit" class="btn">{t('waitSend')}</button>
        </div>
        <p class="waitmsg muted small" role="status" aria-live="polite"></p>
        <i class="sda-mark" data-sda-event="waitlist_sent" data-sda-placement="site-wait" aria-hidden="true"></i>
      </form>
    </div>
  </section>

</main>

<script>
  // The shared analytics snippet counts clicks on [data-sda-event] and offers no JS call,
  // so a non-click event is reported by clicking an empty marker element once.
  const count = (event: string) =>
    document.querySelector<HTMLElement>(`.sda-mark[data-sda-event="${event}"]`)?.click();

  const form = document.querySelector<HTMLFormElement>('.waitform');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = form.querySelector<HTMLElement>('.waitmsg');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const data = Object.fromEntries(new FormData(form).entries());
      if (button) button.disabled = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error(String(res.status));
        if (msg) msg.textContent = form.dataset.done ?? '';
        form.querySelector<HTMLInputElement>('input[type="email"]')?.setAttribute('readonly', '');
        count('waitlist_sent');
      } catch {
        if (msg) msg.textContent = form.dataset.fail ?? '';
        if (button) button.disabled = false;
      }
    });
  }
</script>

<style>
  /*
   * Spacing on one scale (8 12 16 24 32 48 64 96), radii 12 for controls and 16/24 for
   * frames, one curve (--ease) for every transition. Values outside it are a bug.
   */
  .hero { padding: 64px 0 96px; }
  .herogrid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 900px) {
    .herogrid { grid-template-columns: 1.15fr 0.85fr; gap: 64px; }
  }
  .herotext h1 { margin: 0 0 24px; max-width: 14ch; text-wrap: balance; }
  .lede { font-size: 19px; line-height: 1.55; color: #cfcfd6; max-width: 42ch; text-wrap: pretty; }
  .cta { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; }
  .small { font-size: 14px; }
  .maclink {
    color: var(--fg); text-decoration: none; font-weight: 500; font-size: 15px;
    padding: 12px 0; opacity: 0.8;
    transition: opacity 300ms var(--ease);
  }
  .maclink:hover { opacity: 1; text-decoration: underline; text-underline-offset: 4px; }
  .arrow { display: inline-block; }
  :global([dir='rtl']) .arrow { transform: scaleX(-1); }
  .proof { margin-top: 16px; font-size: 14px; color: var(--muted); }

  .btn-store {
    display: inline-flex; align-items: center; gap: 8px;
    transition: transform 300ms var(--ease), box-shadow 300ms var(--ease);
  }
  .btn-store:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(1, 122, 255, 0.35); }
  .btn-store:active { transform: translateY(1px); }
  .btn-store:focus-visible, .maclink:focus-visible { outline: 2px solid var(--cyan); outline-offset: 4px; border-radius: 12px; }

  /* The app in a phone frame: outer 40, gap 8, so the screen is 32 (inner = outer − gap). */
  .heroshot { margin: 0; justify-self: center; position: relative; width: min(300px, 72vw); }
  .heroshot::before {
    content: ''; position: absolute; inset: 12% -24%; z-index: -1; pointer-events: none;
    background: radial-gradient(50% 50% at 50% 50%, rgba(1, 122, 255, 0.22), transparent 70%);
    filter: blur(32px);
  }
  .phone {
    padding: 8px; border-radius: 40px;
    background: #0b0b0e; border: 1px solid #2a2a33;
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }
  .phone img { display: block; width: 100%; height: auto; border-radius: 32px; background: #000; }
  @media (max-width: 899px) { .heroshot { width: min(260px, 64vw); } }

  .sda-mark { display: inline-block; width: 0; height: 0; overflow: hidden; }

  .howgrid { display: grid; gap: 32px; margin-top: 32px; align-items: center; }
  @media (min-width: 900px) { .howgrid { grid-template-columns: 0.9fr 1.1fr; } }
  .howwheel :global(.wheel) { width: min(380px, 80vw); }
  .steps { display: grid; gap: 16px; }
  .num { display: block; font-size: 14px; font-weight: 700; margin-bottom: 8px; }

  /* Features as a quiet list: four boxes in a row read as a template, a rule above each reads as an index. */
  .feats { display: grid; gap: 32px 48px; margin-top: 32px; }
  @media (min-width: 720px) { .feats { grid-template-columns: 1fr 1fr; } }
  .feat { padding-top: 16px; border-top: 1px solid var(--line); }
  .feat h3 { margin-bottom: 8px; }
  .feat p { color: var(--muted); font-size: 16px; max-width: 40ch; }

  .shots { display: grid; gap: 24px; margin-top: 32px; grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 640px) { .shots { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; } }
  .shots figure { margin: 0; }
  .shots img {
    width: 100%; height: auto; display: block;
    border-radius: 16px; border: 1px solid var(--line); background: var(--panel);
  }
  .shots figcaption { margin-top: 12px; font-size: 14px; line-height: 1.45; color: var(--muted); }
  @media (max-width: 640px) { .shots figcaption { font-size: 12px; } }

  .privwrap { max-width: 62ch; }
  .privwrap .lede { margin: 16px 0; }
  .privlink { color: var(--cyan); text-decoration: none; font-weight: 500; white-space: nowrap; }
  .privlink:hover { text-decoration: underline; text-underline-offset: 4px; }

  .waitwrap { max-width: 62ch; }
  .waitwrap .muted { margin: 16px 0 24px; }
  /* Honeypot: clipped in place. `left: -9999px` became 10 000 px of sideways scroll on /ar/. */
  .hp, .sr-only {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap; opacity: 0;
  }
  .sr-only { opacity: 1; }
  .reasons { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
  .reason {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 16px; border-radius: 999px;
    border: 1px solid var(--line); background: var(--panel);
    color: var(--fg); font-size: 14px; cursor: pointer;
  }
  .reason:has(input:checked) { border-color: var(--cyan); }
  .reason input { accent-color: var(--cyan); margin: 0; }
  .waitrow { display: flex; flex-wrap: wrap; gap: 12px; }
  .waitrow input {
    flex: 1 1 240px; min-width: 0;
    padding: 12px 16px; border-radius: 12px;
    border: 1px solid var(--line); background: var(--panel);
    color: var(--fg); font-size: 16px;
  }
  .waitrow input:focus-visible { outline: 2px solid var(--cyan); outline-offset: 1px; }
  .waitrow .btn { flex: 0 0 auto; }
  .waitmsg { margin-top: 12px; min-height: 1.4em; }
</style>
