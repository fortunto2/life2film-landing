---
import CalendarWheel from './CalendarWheel.astro';
import { localePath, useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [
  { t: t('h1t'), d: t('h1d') },
  { t: t('h2t'), d: t('h2d') },
  { t: t('h3t'), d: t('h3d') },
];
const feats = [
  { t: t('f1t'), d: t('f1d') },
  { t: t('f2t'), d: t('f2d') },
  { t: t('f3t'), d: t('f3d') },
  { t: t('f4t'), d: t('f4d') },
];
---

<main>
  <section class="hero">
    <div class="wrap herogrid">
      <div>
        <span class="badge">{t('heroBadge')}</span>
        <h1 set:html={t('heroTitle')} />
        <p class="lede">{t('heroLede')}</p>
        <div class="cta">
          <span class="btn" aria-disabled="true">{t('ctaPrimary')}</span>
          <a
            class="btn-mac"
            href="/studio"
          >
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="currentColor">
              <path d="M11.18 0c.08.9-.28 1.78-.83 2.42-.55.64-1.44 1.13-2.31 1.06-.1-.86.32-1.77.85-2.34C9.44.48 10.4.04 11.18 0zm2.7 5.44c-.05.03-1.63.94-1.61 2.8.02 2.23 1.95 2.97 1.98 2.98-.02.06-.31 1.06-1.02 2.09-.61.9-1.25 1.8-2.26 1.82-.99.02-1.31-.59-2.44-.59-1.13 0-1.48.57-2.42.6-.97.04-1.71-.97-2.33-1.87C2.5 11.44 1.53 8.1 2.83 5.84c.64-1.12 1.8-1.83 3.05-1.85.95-.02 1.85.64 2.43.64.58 0 1.67-.79 2.82-.68.48.02 1.83.19 2.7 1.45z"/>
            </svg>
            {t('macCta')}
          </a>
        </div>
        <p class="muted small">{t('ctaNote')}</p>
        <p class="muted small mac-note">{t('macNote')}</p>
      </div>
      <CalendarWheel />
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{t('howTitle')}</h2>
      <div class="grid cols-3 steps">
        {steps.map((s, i) => (
          <div class="card">
            <span class="num gradient-text">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{t('featTitle')}</h2>
      <div class="grid cols-2 feats">
        {feats.map((f) => (
          <div class="card">
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="screens">
    <div class="wrap">
      <h2>{t('screensTitle')}</h2>
      <div class="shots">
        {[1, 2, 3, 4].map((n) => (
          <figure>
            <img
              src={`/img/shot-0${n}.jpg`}
              alt={t(`s${n}` as 's1')}
              width="620"
              height="1280"
              loading="lazy"
              decoding="async"
            />
            <figcaption>{t(`s${n}` as 's1')}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="priv">
    <div class="wrap privwrap">
      <h2>{t('privTitle')}</h2>
      <p class="lede">{t('privLede')}</p>
      <p class="muted">{t('privNote')}</p>
      <p><a class="privlink" href={'/privacy'}>{t('privLink')} →</a></p>
    </div>
  </section>
</main>

<style>
  .hero { padding-top: 64px; }
  .herogrid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 900px) { .herogrid { grid-template-columns: 1.05fr 1fr; } }

  h1 { margin: 20px 0 18px; }
  .lede { font-size: 19px; color: #cfcfd6; max-width: 54ch; }
  .cta { margin: 28px 0 12px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .small { font-size: 14px; }
  .mac-note { margin-top: 4px; opacity: 0.75; }

  .btn-mac {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 12px 22px; border-radius: 12px;
    border: 1px solid var(--line); background: var(--panel);
    color: var(--fg); text-decoration: none; font-size: 15px; font-weight: 500;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .btn-mac:hover { border-color: #33333d; background: #131318; }

  .steps, .feats { margin-top: 28px; }
  .num { display: block; font-size: 13px; font-weight: 700; letter-spacing: 0.1em; margin-bottom: 10px; }

  .shots {
    display: grid;
    gap: 24px;
    margin-top: 32px;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 860px) { .shots { grid-template-columns: repeat(4, 1fr); } }

  .shots figure { margin: 0; }
  .shots img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: var(--panel);
  }
  .shots figcaption {
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--muted);
  }

  .privwrap { max-width: 62ch; }
  .privwrap .lede { margin: 18px 0 14px; }
  .privlink { display: inline-block; margin-top: 18px; color: var(--cyan); text-decoration: none; font-weight: 500; }
  .privlink:hover { text-decoration: underline; }
</style>
