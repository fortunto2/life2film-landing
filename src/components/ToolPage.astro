---
import Base from '../layouts/Base.astro';
import AgentBlock from './AgentBlock.astro';
import { TOOL, TOOLS } from '../lib/tools';
import { TRANSLATIONS, localesFor, toolPath } from '../lib/tools/index';
import { CHROME, asTranslation } from '../lib/tools-i18n';
import { localePath, type Lang } from '../i18n';
import { relatedForTool } from '../lib/related';

interface Props {
  /** Which tool this is. Everything else comes from the registry. */
  slug: string;
  /** Which language to render it in. Falls back to the English original. */
  lang?: Lang;
}

const { slug, lang = 'en' } = Astro.props;
/** «Saved. The rest.» → ['Saved.', 'The rest.']: the first sentence is shown only after a save. */
const savedSplit = (text: string): [string, string] => {
  const i = text.indexOf('. ');
  return i < 0 ? ['', text] : [text.slice(0, i + 1), text.slice(i + 2)];
};
const waitMode = ['video-splitter', 'scene-detector', 'bpm-detector', 'key-finder'].includes(slug)
  ? 'file'
  : slug === 'video-trimmer' ? 'none' : 'run';
const STUDIO_DMG = 'https://github.com/fortunto2/life2film-landing/releases/latest/download/Life2FilmStudio.dmg';
const base = TOOL[slug];

// The words for this locale, or the English original when there is no translation yet.
const tool = lang === 'en' ? asTranslation(base) : TRANSLATIONS[lang]?.[slug] ?? asTranslation(base);
const chrome = CHROME[lang];
// A song is on the table on both pages: the offer that names cutting to a track's beat fits there.
const phoneAfter = ['bpm-detector', 'add-music-to-video', 'key-finder'].includes(slug) ? chrome.appAfterBeat : chrome.appAfter;
const path = localePath(lang, `/tools/${slug}/`);

/** Only the locales that actually have this page — never claim a translation that does not exist. */
const locales = localesFor(slug);

if (!base) throw new Error(`No registry entry for tool "${slug}"`);

/**
 * The other tools, linked from every page.
 *
 * Cross-links used to exist only where the prose happened to mention another tool, which left
 * video-to-mp3 with one inbound link and the trimmer with four. Generated from the registry, every
 * tool gets the same six — and a new tool is linked from everywhere the moment it is added.
 */
const others = TOOLS.filter((other) => other.slug !== slug).map((other) => ({
  slug: other.slug,
  name: other.name,
  // The blurb has a translation; the name does not, so it stays English on purpose.
  blurb: TRANSLATIONS[lang]?.[other.slug]?.blurb ?? other.blurb,
}));

const related = relatedForTool(slug, lang);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: base.appName,
      url: `https://life2film.com${path}`,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Any browser with WebCodecs',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      publisher: { '@id': 'https://life2film.com/#org' },
      featureList: tool.featureList,
    },
    {
      '@type': 'FAQPage',
      mainEntity: tool.faq.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<Base lang={lang} title={tool.title} description={tool.description} basePath={`/tools/${slug}/`} locales={locales}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <main>
    <section class="tool-head">
      <div class="wrap">
        <a class="back" href={localePath(lang, '/tools/')}>{chrome.allTools}</a>
        <h1>{tool.heading} <span class="gradient-text">{tool.accent}</span></h1>
        <p class="lede">{tool.lede}</p>

        <slot name="tool" />

        {/* Revealed by `tool:shown` or `tool:saved` (see lib/track.ts): the offer at the moment the result exists;
            its first sentence («Saved.») only once something was saved.
            Two cards, one shown: Studio on a Mac, the iPhone app everywhere else (`data-offer`, picked
            by the inline script below). Counted under the same placement as before plus the event
            that names which door: app_store_opened or binary_downloaded. */}
        <div class="app-after" id="appAfter" data-wait={waitMode} hidden>
          <div class="offer" data-offer="phone">
            <img src="/img/app-icon.png" alt="" width="48" height="48" />
            <span><span class="when-saved">{savedSplit(phoneAfter)[0]} </span>{savedSplit(phoneAfter)[1]}</span>
            <a class="ghost primary" href={`https://apps.apple.com/app/id6761656888?pt=128499174&ct=tool-${slug}-result&mt=8`}
               target="_blank" rel="noopener" data-sda-event="app_store_opened" data-sda-placement={`tool-${slug}-result`}>{chrome.appCta}</a>
          </div>
          <div class="offer" data-offer="mac" hidden>
            <img src="/img/studio-icon.png" alt="" width="48" height="48" />
            <span><span class="when-saved">{savedSplit(chrome.studioAfter)[0]} </span>{savedSplit(chrome.studioAfter)[1]}<small class="muted">{chrome.studioNote}</small></span>
            <a class="ghost primary" href={STUDIO_DMG}
               data-sda-event="binary_downloaded" data-sda-placement={`tool-${slug}-result`}>{chrome.studioCta}</a>
          </div>
        </div>
        <script is:inline>
          (() => {
            // While a long job runs (6 s with no result), the same card, counted as `-wait`.
            // Tools that start on a file: splitter, scenes, bpm. The others start on their button
            // (`tool_run`); the trimmer has neither, so it never waits. No delay is added to any job.
            const card = document.getElementById('appAfter');
            if (!card) return;
            const startsOnFile = card.dataset.wait === 'file';
            let timer = 0;
            const setPlacement = (to) => card.querySelectorAll('a[data-sda-placement]').forEach((a) => {
              a.dataset.sdaPlacement = a.dataset.sdaPlacement.replace(/-(result|wait)$/, '-' + to);
              a.href = a.href.replace(/(ct=tool-[a-z0-9-]+?)-(result|wait)/, '$1-' + to);
            });
            const settle = () => { clearTimeout(timer); timer = 0; };
            addEventListener('tool:started', (e) => {
              const started = e.detail === 'tool_run' || (startsOnFile && e.detail === 'file_chosen');
              if (!started || !card.hidden || card.dataset.wait === 'none') return;
              settle();
              timer = setTimeout(() => { if (card.hidden) { setPlacement('wait'); card.hidden = false; card.dataset.waiting = '1'; } }, 6000);
            });
            // Run buttons are counted by the snippet from `data-sda-event="tool_run"`, not through track().
            document.addEventListener('click', (e) => {
              if (e.target instanceof Element && e.target.closest('[data-sda-event="tool_run"]')) {
                dispatchEvent(new CustomEvent('tool:started', { detail: 'tool_run' }));
              }
            }, true);
            addEventListener('tool:failed', () => { settle(); if (card.dataset.waiting) { card.hidden = true; delete card.dataset.waiting; setPlacement('result'); } });
            addEventListener('tool:shown', () => { settle(); if (card.dataset.waiting) { delete card.dataset.waiting; setPlacement('result'); } }, { capture: true });
            addEventListener('tool:saved', () => { settle(); if (card.dataset.waiting) { delete card.dataset.waiting; setPlacement('result'); } }, { capture: true });
          })();
          addEventListener('tool:shown', () => { const n = document.getElementById('appAfter'); if (n) n.hidden = false; });
          addEventListener('tool:saved', () => { const n = document.getElementById('appAfter'); if (n) { n.hidden = false; n.dataset.saved = '1'; } });
        </script>

        <p class="privacy-note muted">
{chrome.privacyNote}
        </p>

        {/*
          The only way from a tool to the app, and counted from both ends under ONE name, like the
          home page's `site-hero`: `ct` tells App Store Connect which tool an install came from,
          `data-sda-placement` tells our counter the click happened. Per tool, because "which tool
          feeds the app" is the question this exists to answer.
        */}
        <div class="app-pitch">
          <div class="offer" data-offer="phone">
            <img src="/img/app-icon.png" alt="" width="48" height="48" loading="lazy" />
            <span>{chrome.appPitch}</span>
            <a class="ghost primary" href={`https://apps.apple.com/app/id6761656888?pt=128499174&ct=tool-${slug}&mt=8`}
               target="_blank" rel="noopener" data-sda-event="app_store_opened" data-sda-placement={`tool-${slug}`}>{chrome.appCta}</a>
          </div>
          <div class="offer" data-offer="mac" hidden>
            <img src="/img/studio-icon.png" alt="" width="48" height="48" loading="lazy" />
            <span>{chrome.studioPitch}<small class="muted">{chrome.studioNote}</small></span>
            <a class="ghost primary" href={STUDIO_DMG}
               data-sda-event="binary_downloaded" data-sda-placement={`tool-${slug}`}>{chrome.studioCta}</a>
          </div>
        </div>
        {/* A desktop Mac gets Studio; an iPad says "Macintosh" too, but reports touch points (a Mac reports 0). Everything else keeps
            the iPhone offer, as before. Runs before paint of the cards below the tool, no flash on top. */}
        <script is:inline>
          (() => {
            const mac = /Macintosh/.test(navigator.userAgent) && !navigator.maxTouchPoints;
            if (!mac) return;
            for (const n of document.querySelectorAll('[data-offer]')) n.hidden = n.dataset.offer !== 'mac';
          })();
        </script>
      </div>
    </section>

    <section>
      <div class="wrap prose">
        <slot name="prose" />

        <h2>{chrome.questions}</h2>
        {tool.faq.map(({ q, a }) => (
          <>
            <h3 class="q">{q}</h3>
            <p>{a}</p>
          </>
        ))}

        {lang === 'en' && base.reading && (
          <>
            <h2>Further reading</h2>
            <ul class="related">
              <li>
                <a href={base.reading.href}>{base.reading.title}</a> — {base.reading.note}
              </li>
            </ul>
          </>
        )}

        {related && (
          <>
            <h2>{related.heading}</h2>
            <ul class="related">
              {related.links.map((link) => (
                <li><a href={link.href}>{link.text}</a></li>
              ))}
            </ul>
          </>
        )}

        <h2>{chrome.otherTools}</h2>
        <ul class="related">
          {others.map((other) => (
            <li>
              <a href={toolPath(lang, other.slug)}>{other.name}</a> — {other.blurb}
            </li>
          ))}
        </ul>

        {/*
          Rendered here rather than wired into each page: the registry knows which tools have a
          snippet, so all seven get one instead of the two that happened to import the component.
        */}
        {base.code && base.prompt && base.agentJob && (
          <AgentBlock job={base.agentJob} code={base.code} prompt={base.prompt} lang={lang} />
        )}
      </div>
    </section>
  </main>

  <style is:global>
    .tool-head { padding-bottom: 40px; }
    .tool-head .back { color: var(--muted); text-decoration: none; font-size: 14px; }
    .tool-head .back:hover { color: var(--fg); }
    .tool-head h1 { margin: 14px 0 12px; }
    .tool-head .lede { color: #cfcfd6; max-width: 60ch; margin-bottom: 30px; font-size: 19px; }

    .tool { border: 1px solid var(--line); border-radius: 18px; background: var(--panel); padding: 22px; }
    /* `.controls` and `.control` set display, which beats the browser's own [hidden] rule: every
       control panel was on screen before a file was chosen, all modes at once. */
    .tool [hidden] { display: none !important; }

    .drop {
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
      min-height: 150px; padding: 24px; text-align: center; cursor: pointer;
      border: 1.5px dashed var(--line); border-radius: 14px;
      transition: border-color .15s ease, background .15s ease;
    }
    .drop:hover, .drop.over { border-color: var(--cyan); background: rgba(0, 242, 224, .04); }
    .drop strong { font-size: 17px; }

    .controls { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin-top: 18px; }
    .control { display: flex; gap: 8px; align-items: center; font-size: 14px; }
    .control.checkbox { cursor: pointer; }
    .control input[type=checkbox] { width: 16px; height: 16px; accent-color: #00f2e0; }
    .spacer { flex: 1; }

    .tool select, .tool input[type=text] {
      padding: 9px 12px; border-radius: 10px; font: inherit; font-size: 14px; cursor: pointer;
      color: var(--fg); background: #0a0a0d; border: 1px solid var(--line);
    }
    .tool select:hover { border-color: var(--cyan); }

    /* Chrome draws the list itself when asked (customizable select). Without it macOS 26 opens a
       system menu twice the size of the control, translucent over the page text — it read as a
       glitch. Safari and Firefox keep their own menu, which is fine. */
    @supports (appearance: base-select) {
      .tool select, .tool select::picker(select) { appearance: base-select; }
      .tool select { display: inline-flex; align-items: center; gap: 8px; }
      .tool select::picker-icon { color: var(--muted); transition: rotate .15s; }
      .tool select:open::picker-icon { rotate: 180deg; }
      .tool select::picker(select) {
        margin-top: 6px; padding: 4px; border-radius: 10px;
        color: var(--fg); background: #0a0a0d; border: 1px solid var(--line);
        box-shadow: 0 12px 32px rgba(0, 0, 0, .5);
      }
      .tool select option {
        padding: 8px 12px; border-radius: 7px; font-size: 14px; cursor: pointer;
      }
      .tool select option::checkmark { color: var(--cyan); }
      .tool select option:hover, .tool select option:focus-visible { background: #17171c; }
      .tool select option:checked { color: var(--cyan); }
    }

    .ghost {
      padding: 9px 16px; border-radius: 10px; font: inherit; font-size: 14px; cursor: pointer;
      color: var(--fg); background: transparent; border: 1px solid var(--line);
    }
    .ghost:hover:not(:disabled) { border-color: var(--cyan); color: var(--cyan); }
    .ghost:disabled { opacity: .45; cursor: default; }
    .ghost.primary { border-color: rgba(0,242,224,.4); color: var(--cyan); }

    .status { margin-top: 18px; }
    .status.err .statustext { color: var(--pink); }
    .bar { height: 3px; border-radius: 2px; background: #17171c; overflow: hidden; }
    .bar span { display: block; height: 100%; width: 0; background: var(--grad); transition: width .12s linear; }
    .statustext { margin-top: 9px; font-size: 15px; color: var(--muted); }

    .facts { display: flex; flex-wrap: wrap; gap: 22px; margin-top: 18px; font-size: 15px; color: #cfcfd6; }
    .facts b { color: var(--fg); }

    .verdict {
      margin-top: 14px; padding: 11px 14px; border-radius: 10px; font-size: 14px;
      border: 1px solid var(--line); background: #0a0a0d; color: #cfcfd6;
    }
    .verdict.warn { border-color: rgba(255,166,29,.4); color: var(--orange); }
    .verdict.bad { border-color: rgba(250,63,165,.4); color: var(--pink); }

    .privacy-note { margin-top: 16px; font-size: 14px; max-width: 62ch; }
    .app-pitch, .app-after {
      margin-top: 18px; padding: 14px 16px; border-radius: 16px; font-size: 15px;
      border: 1px solid var(--line); color: #cfcfd6;
      background: linear-gradient(135deg, rgba(0,242,224,.06), rgba(250,63,165,.05));
    }
    .app-after { margin-top: 14px; border-color: rgba(0,242,224,.45); color: var(--fg); }
    .app-after[hidden], .offer[hidden] { display: none; }
    .offer { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: center; }
    .offer img { width: 48px; height: 48px; border-radius: 11px; flex: none; }
    .offer span { flex: 1 1 28ch; }
    .offer small { display: block; margin-top: 4px; font-size: 13px; }
    .offer a { text-decoration: none; white-space: nowrap; }
    .prose .q { margin: 28px 0 8px; font-size: 17px; }

    .related { padding-left: 0; list-style: none; }
    .related li { margin-bottom: 10px; color: var(--muted); font-size: 15px; }
    .related a { color: var(--cyan); text-decoration: none; font-weight: 500; }
    .related a:hover { text-decoration: underline; }
    .app-after:not([data-saved]) .when-saved { display: none; }
  </style>
</Base>
