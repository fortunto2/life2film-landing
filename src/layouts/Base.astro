---
import { languages, localePath, rtl, useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang; title: string; description: string; basePath?: string }
const { lang, title, description, basePath = '/' } = Astro.props;
const langEntries = Object.entries(languages) as [Lang, string][];
const t = useTranslations(lang);

const ORG = {
  '@type': 'Organization',
  '@id': 'https://life2film.com/#org',
  name: 'SuperDuperAi, Corp.',
  url: 'https://superduperai.co',
  email: 'info@life2film.com',
  telephone: '+1-818-619-0966',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1207 Delaware Ave, Unit 4241',
    addressLocality: 'Wilmington',
    addressRegion: 'DE',
    postalCode: '19806',
    addressCountry: 'US',
  },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ORG,
    {
      '@type': 'WebSite',
      '@id': 'https://life2film.com/#website',
      url: 'https://life2film.com',
      name: 'Life2Film',
      description,
      inLanguage: ['en', 'ru', 'tr'],
      publisher: { '@id': 'https://life2film.com/#org' },
    },
    {
      '@type': 'MobileApplication',
      '@id': 'https://life2film.com/#ios',
      name: 'Life2Film',
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'iOS 17+',
      url: 'https://life2film.com',
      publisher: { '@id': 'https://life2film.com/#org' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'On-device AI video montage',
        'Beat-synced editing',
        'Calendar wheel over the photo library',
        'Works offline, no account required',
      ],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://life2film.com/#studio',
      name: 'Life2Film Studio',
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'macOS 13+',
      processorRequirements: 'Apple Silicon',
      url: 'https://life2film.com/studio/',
      downloadUrl: 'https://github.com/fortunto2/life2film-landing/releases',
      softwareVersion: '0.1.1',
      publisher: { '@id': 'https://life2film.com/#org' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        '30 per-frame quality and composition features',
        'Ensemble scene segmentation',
        'Automatic montage assembly',
        'Direct import from the Apple Photos library',
      ],
    },
  ],
};
---
<!doctype html>
<html lang={lang} dir={rtl.has(lang) ? "rtl" : "ltr"}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`https://life2film.com${localePath(lang, basePath)}`} />
  <meta property="og:site_name" content="Life2Film" />
  <meta property="og:image" content="/img/hero.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={`https://life2film.com${localePath(lang, basePath)}`} />
  {langEntries.map(([code]) => (
    <link rel="alternate" hreflang={code} href={`https://life2film.com${localePath(code, basePath)}`} />
  ))}
  <link rel="alternate" hreflang="x-default" href={`https://life2film.com${localePath('en', basePath)}`} />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎞️</text></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  {import.meta.env.PROD && (
    <>
      {/*
        Our own counter. No cookie and no client-side id at all — the anonymous id is derived
        at the edge and rotates daily — so it adds nothing to the consent question that GA
        below has already raised. It is what makes this landing comparable with the iOS app in
        one query instead of two dashboards. https://analytics.superduperai.co
      */}
      <script defer src="https://analytics.superduperai.co/sda.js" data-source="life2film" is:inline></script>

      <script async src="https://www.googletagmanager.com/gtag/js?id=G-856SXW60BG" is:inline></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        // No cross-site ad signals; this is traffic measurement, nothing more.
        gtag('config', 'G-856SXW60BG', { anonymize_ip: true, allow_google_signals: false });
      </script>
    </>
  )}
</head>
<body>
  <div class="glow" aria-hidden="true"></div>

  <nav>
    <div class="wrap navrow">
      <a class="logo" href={localePath(lang, '/')}>
        <span class="dot" aria-hidden="true"></span>Life2Film
      </a>
      <div class="navlinks">
        <a href={localePath(lang, '/about')}>{t('navAbout')}</a>
        <a href={localePath(lang, '/studio')}>{t('navStudio')}</a>
        <a href={'/blog/'}>{t('navBlog')}</a>
        <a href={localePath(lang, '/support')}>{t('navSupport')}</a>
      </div>
      <div class="langs">
        {langEntries.map(([code, label]) => (
          <a class={`lang ${code === lang ? 'on' : ''}`} href={localePath(code, basePath)}>{label}</a>
        ))}
      </div>
    </div>
  </nav>

  <slot />

  <footer>
    <div class="wrap footrow">
      <span>{t('footerTag')}</span>
      <div class="footlinks">
        <a href={localePath(lang, '/privacy')}>{t('navPrivacy')}</a>
        <a href={localePath(lang, '/support')}>{t('navSupport')}</a>
        <a href="/llms.txt">{t('footerLlms')}</a>
        <a href="mailto:info@life2film.com">info@life2film.com</a>
      </div>
      <span class="muted">© 2026 SuperDuperAI. {t('footerRights')}</span>
    </div>
  </footer>
</body>
</html>

<style is:global>
  :root {
    --bg: #050506;
    --panel: #0d0d10;
    --line: #1c1c22;
    --fg: #f2f2f4;
    --muted: #8a8a95;
    --cyan: #00f2e0;
    --blue: #017aff;
    --pink: #fa3fa5;
    --orange: #ffa61d;
    --yellow: #feff00;
    --grad: linear-gradient(120deg, var(--cyan), var(--blue) 35%, var(--pink) 65%, var(--orange) 85%, var(--yellow));
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: 'Space Grotesk', ui-sans-serif, system-ui, -apple-system, sans-serif;
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  .glow {
    position: fixed;
    inset: -30vh 0 auto 0;
    height: 70vh;
    pointer-events: none;
    background: radial-gradient(50% 50% at 50% 50%, rgba(1, 122, 255, 0.18), transparent 70%);
    filter: blur(40px);
    z-index: 0;
  }

  .wrap { width: min(1080px, 92vw); margin-inline: auto; }

  nav {
    position: sticky; top: 0; z-index: 10;
    background: rgba(5, 5, 6, 0.72);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .navrow { display: flex; align-items: center; gap: 24px; height: 64px; }
  .logo {
    display: inline-flex; align-items: center; gap: 10px;
    font-weight: 700; letter-spacing: -0.02em; font-size: 18px;
    color: var(--fg); text-decoration: none;
  }
  .dot {
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--grad);
    box-shadow: 0 0 14px rgba(0, 242, 224, 0.5);
  }
  .navlinks { display: flex; gap: 20px; margin-left: auto; }
  .navlinks a, .footlinks a {
    color: var(--muted); text-decoration: none; font-size: 15px;
    transition: color 0.15s ease;
  }
  .navlinks a:hover, .footlinks a:hover { color: var(--fg); }
  .langs { display: flex; gap: 6px; }
  .lang {
    padding: 4px 9px; border-radius: 7px; font-size: 13px; font-weight: 500;
    color: var(--muted); text-decoration: none; border: 1px solid transparent;
  }
  .lang:hover { color: var(--fg); }
  .lang.on { color: var(--fg); border-color: var(--line); background: var(--panel); }

  main { position: relative; z-index: 1; }

  h1, h2, h3 { letter-spacing: -0.03em; line-height: 1.1; margin: 0; }
  h1 { font-size: clamp(40px, 7vw, 68px); font-weight: 700; }
  h2 { font-size: clamp(28px, 4vw, 38px); font-weight: 700; }
  h3 { font-size: 19px; font-weight: 700; }
  p { margin: 0; }
  .muted { color: var(--muted); }

  .badge {
    display: inline-block; padding: 6px 13px; border-radius: 999px;
    border: 1px solid var(--line); background: var(--panel);
    font-size: 13px; letter-spacing: 0.02em; color: var(--muted);
  }

  .gradient-text {
    background: var(--grad);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .btn {
    display: inline-block; padding: 13px 26px; border-radius: 12px;
    font-weight: 500; text-decoration: none; font-size: 16px;
    color: #050506; background: var(--grad);
    box-shadow: 0 8px 28px rgba(1, 122, 255, 0.25);
  }
  .btn[aria-disabled='true'] { opacity: 0.92; cursor: default; }

  section { padding: 84px 0; }
  section + section { border-top: 1px solid var(--line); }

  .grid { display: grid; gap: 22px; }
  @media (min-width: 720px) { .grid.cols-2 { grid-template-columns: 1fr 1fr; } .grid.cols-3 { grid-template-columns: repeat(3, 1fr); } }

  .card {
    padding: 24px; border-radius: 16px;
    border: 1px solid var(--line); background: var(--panel);
  }
  .card h3 { margin-bottom: 8px; }
  .card p { color: var(--muted); font-size: 15px; }

  .prose { max-width: 68ch; }
  .prose h2 { margin: 36px 0 12px; font-size: 24px; }
  .prose p, .prose li { color: #cfcfd6; margin-bottom: 12px; }
  .prose a { color: var(--cyan); }
  .prose code { background: var(--panel); padding: 2px 6px; border-radius: 5px; font-size: 14px; }

  footer { border-top: 1px solid var(--line); padding: 32px 0; margin-top: 40px; }
  .footrow { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; justify-content: space-between; font-size: 14px; color: var(--muted); }
  .footlinks { display: flex; gap: 18px; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
