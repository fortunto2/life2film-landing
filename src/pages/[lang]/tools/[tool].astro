---
import ToolPage from '../../../components/ToolPage.astro';
import VideoTrimmer from '../../../components/tools/VideoTrimmer.astro';
import VideoCompressor from '../../../components/tools/VideoCompressor.astro';
import VideoToMp3 from '../../../components/tools/VideoToMp3.astro';
import VideoConverter from '../../../components/tools/VideoConverter.astro';
import VideoSplitter from '../../../components/tools/VideoSplitter.astro';
import BpmDetector from '../../../components/tools/BpmDetector.astro';
import SceneDetector from '../../../components/tools/SceneDetector.astro';
import { TOOLS } from '../../../lib/tools';
import { TRANSLATIONS } from '../../../lib/tools/index';
import type { Lang } from '../../../i18n';

/**
 * Tool pages in other languages.
 *
 * One route per locale and tool that has a translation. The interface components are the very same
 * ones the English pages use — a translation changes the words, never the machine.
 */
export function getStaticPaths() {
  return Object.entries(TRANSLATIONS).flatMap(([lang, tools]) =>
    TOOLS.filter((tool) => tools?.[tool.slug]).map((tool) => ({
      params: { lang, tool: tool.slug },
      props: { slug: tool.slug, lang: lang as Lang },
    })),
  );
}

const { slug, lang } = Astro.props;

const COMPONENTS = {
  'video-trimmer': VideoTrimmer,
  'video-compressor': VideoCompressor,
  'video-to-mp3': VideoToMp3,
  'video-converter': VideoConverter,
  'video-splitter': VideoSplitter,
  'bpm-detector': BpmDetector,
  'scene-detector': SceneDetector,
} as const;

const Tool = COMPONENTS[slug as keyof typeof COMPONENTS];
---

<ToolPage slug={slug} lang={lang}>
  <Tool slot="tool" />
</ToolPage>
