---
import Base from '../../layouts/Base.astro';
import { GROUPS, TOOLS, byGroup } from '../../lib/tools';

const title = 'Free video tools that run in your browser — no upload, no watermark';
const description =
  'Trim, compress, convert and split video without uploading it. Everything runs in your browser through WebCodecs — no size limit, no watermark, no sign-up.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Life2Film Tools',
  url: 'https://life2film.com/tools/',
  description,
  publisher: { '@id': 'https://life2film.com/#org' },
  hasPart: TOOLS.map((tool) => ({
    '@type': 'WebApplication',
    name: tool.appName,
    url: `https://life2film.com/tools/${tool.slug}/`,
    applicationCategory: 'MultimediaApplication',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  })),
};
---

<Base lang="en" title={title} description={description} basePath="/tools/" localized={false}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <main>
    <section>
      <div class="wrap">
        <h1>Tools</h1>
        <p class="lede">
          Video tools that run on your own machine, in a browser tab. Nothing uploads — which is
          also why they are free, have no size limit and add no watermark.
        </p>

        {GROUPS.map((group) => (
          <div class="group">
            <h2 class="grouphead">{group.name}</h2>
            <p class="groupnote muted">{group.note}</p>
            <div class="grid cols-2 tools">
              {byGroup(group.id).map((tool) => (
                <a class="card tool" href={`/tools/${tool.slug}/`}>
                  <h3>{tool.name}</h3>
                  <p>{tool.blurb}</p>
                  <span class="go">Open →</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section>
      <div class="wrap prose">
        <h2>Why these exist</h2>
        <p>
          <a href="/">Life2Film</a> analyses footage and assembles it into a montage. That engine is
          a set of separable parts — one finds the beat in music, another finds the cuts in a video,
          another decides which moments are worth keeping.
        </p>
        <p>
          Each part is useful on its own, and each is small enough to run in a browser tab. So rather
          than describe what the engine does, these pages let you run it.
        </p>
        <p>
          The whole thing works without a server. Your file is read into memory, analysed by
          WebAssembly compiled from the same Rust the app uses, and forgotten when you close the tab.
          There is no account, no queue and no upload — not as a privacy promise, but as a fact about
          how the page is built.
        </p>

        <h2>Use the engine yourself</h2>
        <p>
          The analysis behind the last three tools is published as a package. It finds the beat in
          music, the cuts in a video, and scores frames for picture quality — in a browser tab or in
          Node, with no server and no API key.
        </p>
        <pre class="install"><code>npm i life2film-engine</code></pre>
        <p>
          Free for personal projects, study, research, charities and public institutions
          (<a href="https://www.npmjs.com/package/life2film-engine">PolyForm Noncommercial</a>).
          Commercial use needs a licence — write to
          <a href="mailto:info@life2film.com">info@life2film.com</a> and you will probably get one.
        </p>
        <p>
          Every page here is also available as markdown: append <code>.md</code> to its address, or
          request it with <code>Accept: text/markdown</code>. The
          <a href="/llms.txt">site overview for agents</a> lists everything in one file.
        </p>
      </div>
    </section>
  </main>

  <style>
    h1 { margin-bottom: 14px; }
    .lede { color: #cfcfd6; max-width: 58ch; margin-bottom: 34px; font-size: 19px; }
    .group { margin-bottom: 44px; }
    .grouphead { font-size: 22px; margin-bottom: 4px; }
    .groupnote { font-size: 15px; margin-bottom: 18px; }
    .tools { align-items: stretch; }
    .tool {
      display: flex; flex-direction: column; gap: 8px;
      text-decoration: none; color: inherit;
      transition: border-color .15s ease, transform .15s ease;
    }
    a.tool:hover { border-color: var(--cyan); transform: translateY(-2px); }
    .tool .badge { align-self: flex-start; }
    .tool h3 { margin-top: 4px; }
    .go { margin-top: auto; padding-top: 10px; font-size: 14px; color: var(--cyan); }
    .soon { opacity: .62; }
    .install {
      margin: 14px 0; padding: 14px 16px; border-radius: 10px;
      background: #08080a; border: 1px solid var(--line); overflow-x: auto;
    }
    .install code { font-family: ui-monospace, monospace; font-size: 14px; color: var(--cyan); }
  </style>
</Base>
