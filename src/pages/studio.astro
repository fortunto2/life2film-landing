---
import Base from '../layouts/Base.astro';

const DMG = 'https://github.com/fortunto2/life2film-landing/releases/latest/download/Life2FilmStudio.dmg';
const RELEASES = 'https://github.com/fortunto2/life2film-landing/releases';

// The 30 per-frame features the analyser computes, grouped the way a person thinks about them.
const groups = [
  {
    title: 'Is the shot usable',
    items: ['sharpness', 'stability', 'noise', 'exposure_balance', 'contrast_balance', 'brightness', 'white_balance'],
    note: 'Shaky handoffs, out-of-focus starts and blown-out frames are scored down before anything else is considered.',
  },
  {
    title: 'Who and what is in it',
    items: ['face_presence', 'face_area_ratio', 'face_quality', 'body_area_ratio', 'animal_presence', 'text_likelihood'],
    note: 'Faces are detected with a YOLO model; quality combines detector confidence, landmark visibility and how much of the frame the face occupies — a sharp face filling the shot outranks a distant one.',
  },
  {
    title: 'Is it composed well',
    items: ['composition', 'symmetry', 'asymmetry', 'horizon_level', 'attention_saliency', 'bokeh', 'aesthetic_score'],
    note: 'Framing, subject placement and depth separation, so a deliberate shot wins over an accidental one.',
  },
  {
    title: 'How it looks',
    items: ['colorfulness', 'saturation', 'hue', 'color_harmony', 'color_temperature', 'dominant_color_variety', 'entropy', 'texture_energy', 'edge_direction_entropy', 'uniformity', 'std_dev'],
    note: 'Colour and texture signatures also tell the segmenter when the scene has actually changed rather than the camera merely moving.',
  },
];
---
<Base
  lang="en"
  title="Life2Film Studio — desktop video analyser (beta)"
  description="Analyse large video archives on your Mac: 30 per-frame features, automatic scene segmentation, and montage assembly. Runs entirely on your machine."
  basePath="/studio"
>
  <main>
    <section class="hero">
      <div class="wrap">
        <span class="badge beta">Public beta</span>
        <h1>Studio</h1>
        <p class="lede">
          The desktop half of Life2Film. Point it at an archive of raw footage and it scores every
          frame, finds where the scenes actually change, and assembles a montage from the segments
          worth keeping. Built for the case the phone struggles with: hundreds of clips at once.
        </p>

        <div class="cta">
          <a class="btn" href={DMG}>Download for Mac</a>
          <a class="btn-ghost" href={RELEASES}>All releases</a>
        </div>
        <p class="muted small">Apple Silicon · macOS 13+ · free while in beta</p>

        <figure class="shot">
          <img src="/img/studio.jpg" alt="Life2Film Studio analysing a clip: feature scores, segment timeline and audio waveform" width="1400" height="1026" loading="lazy" decoding="async" />
          <figcaption>Per-frame feature scores on the right, segment timeline and audio energy below the preview.</figcaption>
        </figure>
      </div>
    </section>

    <section>
      <div class="wrap prose">
        <h2>Install</h2>
        <p>With Homebrew:</p>
        <pre><code>brew install --cask fortunto2/tap/life2film-studio</code></pre>
        <p>
          Or <a href={DMG}>download the DMG</a> and drag the app into Applications. It is signed with
          a Developer ID and notarised by Apple, so it opens without Gatekeeper warnings, and ffmpeg
          is linked statically — there is nothing to install first.
        </p>
      </div>
    </section>

    <section>
      <div class="wrap">
        <h2>What it does</h2>
        <div class="grid cols-3 steps">
          <div class="card">
            <span class="num gradient-text">01</span>
            <h3>Scores every frame</h3>
            <p>Thirty measurements per frame, from sharpness and stability to face quality and aesthetic score. Each becomes a signal you can see and sort by.</p>
          </div>
          <div class="card">
            <span class="num gradient-text">02</span>
            <h3>Finds the segments</h3>
            <p>An ensemble of detectors decides where a scene genuinely changes, instead of cutting whenever the camera moves. Shots are classified by scale, close-up through wide.</p>
          </div>
          <div class="card">
            <span class="num gradient-text">03</span>
            <h3>Assembles the montage</h3>
            <p>Segments are ranked, trimmed and laid out to a target duration. Audio energy and beat positions shape where the cuts land.</p>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <h2>What it measures</h2>
        <p class="muted lede-sub">Every number below is computed locally, per frame, and exposed in the interface.</p>
        <div class="grid cols-2 feats">
          {groups.map((g) => (
            <div class="card">
              <h3>{g.title}</h3>
              <ul class="chips">
                {g.items.map((i) => <li>{i}</li>)}
              </ul>
              <p>{g.note}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section>
      <div class="wrap prose">
        <h2>Built for big archives</h2>
        <p>
          A phone is fine for a day or a trip. Studio is for the folder that has been accumulating
          for years: it runs the analysis in a native engine, keeps the scores so a re-cut does not
          re-analyse anything, and lets you work through hundreds of files in one pass rather than
          one clip at a time.
        </p>

        <h2>Still a beta</h2>
        <p>
          The analysis engine is the mature part; the interface around it is not. Expect rough edges,
          missing polish and the occasional dead end. It does not touch your originals — nothing is
          overwritten and nothing is uploaded — but do not make it the only copy of anything.
        </p>
        <p>
          Found something broken? <a href="mailto:info@superduperai.co">info@superduperai.co</a>, or
          open an issue on <a href={RELEASES}>the releases page</a>.
        </p>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero { padding-top: 56px; }
  h1 { font-size: clamp(40px, 6vw, 60px); margin: 16px 0 18px; }
  .lede { font-size: 19px; color: #cfcfd6; max-width: 62ch; }
  .lede-sub { max-width: 60ch; margin-top: 10px; }
  .badge.beta { border-color: #33333d; color: var(--cyan); }

  .cta { margin: 28px 0 10px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .small { font-size: 14px; }
  .btn-ghost {
    display: inline-flex; align-items: center; padding: 12px 22px; border-radius: 12px;
    border: 1px solid var(--line); background: var(--panel); color: var(--fg);
    text-decoration: none; font-size: 15px; font-weight: 500;
  }
  .btn-ghost:hover { border-color: #33333d; }

  .shot { margin: 44px 0 0; }
  .shot img {
    width: 100%; height: auto; display: block;
    border-radius: 16px; border: 1px solid var(--line);
  }
  .shot figcaption { margin-top: 12px; font-size: 14px; color: var(--muted); }

  .steps, .feats { margin-top: 28px; }
  .num { display: block; font-size: 13px; font-weight: 700; letter-spacing: 0.1em; margin-bottom: 10px; }

  .chips { list-style: none; padding: 0; margin: 0 0 14px; display: flex; flex-wrap: wrap; gap: 7px; }
  .chips li {
    font-size: 12.5px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    padding: 4px 9px; border-radius: 7px;
    background: #16161b; border: 1px solid var(--line); color: #b9b9c4;
  }

  pre {
    background: var(--panel); border: 1px solid var(--line); border-radius: 12px;
    padding: 16px 18px; overflow-x: auto; margin: 12px 0 18px;
  }
  pre code { background: none; padding: 0; font-size: 14px; color: var(--cyan); }
</style>
