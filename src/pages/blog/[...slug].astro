---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => !data.draft);
  return posts.map((post: CollectionEntry<'blog'>) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const url = `https://life2film.com/blog/${post.id}/`;

/*
 * Without this a post carried only the site-wide graph, which says the page is a
 * MobileApplication called Life2Film — the same claim the pricing page makes. Nothing told
 * Google the page is an article, who wrote it or when, and those are exactly the fields it
 * reads when deciding whether a page deserves the query behind it.
 */
const article = {
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  inLanguage: 'en',
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  author: { '@id': 'https://life2film.com/#org' },
  publisher: { '@id': 'https://life2film.com/#org' },
  isPartOf: { '@id': 'https://life2film.com/#website' },
};
---
<Base
  lang="en"
  title={`${post.data.title} — Life2Film`}
  description={post.data.description}
  basePath={`/blog/${post.id}`}
  locales={['en']}
  schema={[article]}
>
  <main>
    <section>
      <article class="wrap prose">
        <a class="back" href="/blog/">← Blog</a>
        <h1>{post.data.title}</h1>
        <p class="muted meta">
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          {post.data.updated && <> · updated {fmt(post.data.updated)}</>}
        </p>
        <Content />
        <aside class="app-end">
          <img src="/img/app-icon.png" alt="" width="48" height="48" />
          <span><strong>Life2Film for iPhone</strong> picks the best moments of a day and cuts them to the music, on the phone. No account, nothing uploaded.</span>
          <a class="ghost primary" href={`https://apps.apple.com/app/id6761656888?pt=128499174&ct=blog-${post.id}-end&mt=8`} target="_blank" rel="noopener"
             data-sda-event="app_store_opened" data-sda-placement={`blog-${post.id}-end`}>Get the app</a>
        </aside>
      </article>
      <script is:inline define:vars={{ slug: post.id }}>
        // Links written in the markdown carry no tracking attributes; until 20 Nov 2026 every App Store
        // click from an article was invisible, and the blog read as converting nobody.
        document.querySelectorAll('article.prose a[href*="apps.apple.com"]:not([data-sda-event])').forEach((a) => {
          a.dataset.sdaEvent = 'app_store_opened';
          a.dataset.sdaPlacement = `blog-${slug}-inline`;
        });
      </script>
    </section>
  </main>
</Base>

<style>
  .back { display: inline-block; margin-bottom: 20px; color: var(--muted); text-decoration: none; font-size: 15px; }
  .back:hover { color: var(--fg); }
  .app-end { display: flex; gap: 14px; align-items: center; margin-top: 40px; padding: 16px; border: 1px solid #2a2a33; border-radius: 14px; }
  .app-end span { flex: 1; color: #cfcfd6; font-size: 15px; }
  @media (max-width: 560px) { .app-end { flex-wrap: wrap; } }
  h1 { font-size: clamp(30px, 4.5vw, 42px); margin-bottom: 10px; }
  .meta { font-size: 14px; margin-bottom: 34px; }

  article :global(h2) { margin: 40px 0 14px; font-size: 25px; }
  article :global(h3) { margin: 28px 0 8px; font-size: 18px; }
  article :global(p), article :global(li) { color: #cfcfd6; margin-bottom: 14px; }
  article :global(ul), article :global(ol) { padding-left: 22px; }
  article :global(a) { color: var(--cyan); }
  article :global(strong) { color: var(--fg); }
  article :global(blockquote) {
    margin: 22px 0; padding: 14px 20px; border-left: 3px solid var(--line);
    background: var(--panel); border-radius: 0 10px 10px 0; color: #b9b9c4;
  }
  article :global(table) { width: 100%; border-collapse: collapse; margin: 22px 0; font-size: 15px; }
  article :global(th), article :global(td) {
    text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); color: #cfcfd6;
  }
  article :global(th) { color: var(--fg); font-weight: 700; }
  article :global(code) { background: var(--panel); padding: 2px 6px; border-radius: 5px; font-size: 14px; }
</style>
