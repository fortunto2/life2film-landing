---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => !data.draft);
  return posts.map((post: CollectionEntry<'blog'>) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const url = `https://life2film.com/blog/${post.id}/`;

/*
 * Without this a post carried only the site-wide graph, which says the page is a
 * MobileApplication called Life2Film — the same claim the pricing page makes. Nothing told
 * Google the page is an article, who wrote it or when, and those are exactly the fields it
 * reads when deciding whether a page deserves the query behind it.
 */
const article = {
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  inLanguage: 'en',
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  author: { '@id': 'https://life2film.com/#org' },
  publisher: { '@id': 'https://life2film.com/#org' },
  isPartOf: { '@id': 'https://life2film.com/#website' },
};
---
<Base
  lang="en"
  title={`${post.data.title} — Life2Film`}
  description={post.data.description}
  basePath={`/blog/${post.id}`}
  schema={[article]}
>
  <main>
    <section>
      <article class="wrap prose">
        <a class="back" href="/blog/">← Blog</a>
        <h1>{post.data.title}</h1>
        <p class="muted meta">
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          {post.data.updated && <> · updated {fmt(post.data.updated)}</>}
        </p>
        <Content />
      </article>
    </section>
  </main>
</Base>

<style>
  .back { display: inline-block; margin-bottom: 20px; color: var(--muted); text-decoration: none; font-size: 15px; }
  .back:hover { color: var(--fg); }
  h1 { font-size: clamp(30px, 4.5vw, 42px); margin-bottom: 10px; }
  .meta { font-size: 14px; margin-bottom: 34px; }

  article :global(h2) { margin: 40px 0 14px; font-size: 25px; }
  article :global(h3) { margin: 28px 0 8px; font-size: 18px; }
  article :global(p), article :global(li) { color: #cfcfd6; margin-bottom: 14px; }
  article :global(ul), article :global(ol) { padding-left: 22px; }
  article :global(a) { color: var(--cyan); }
  article :global(strong) { color: var(--fg); }
  article :global(blockquote) {
    margin: 22px 0; padding: 14px 20px; border-left: 3px solid var(--line);
    background: var(--panel); border-radius: 0 10px 10px 0; color: #b9b9c4;
  }
  article :global(table) { width: 100%; border-collapse: collapse; margin: 22px 0; font-size: 15px; }
  article :global(th), article :global(td) {
    text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); color: #cfcfd6;
  }
  article :global(th) { color: var(--fg); font-weight: 700; }
  article :global(code) { background: var(--panel); padding: 2px 6px; border-radius: 5px; font-size: 14px; }
</style>
