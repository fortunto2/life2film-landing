---
// Without this page Cloudflare Pages falls back to index.html and answers 200 for every
// unknown path. That is a soft 404: crawlers spend budget on pages that do not exist, AI
// agents are told every well-known file is present, and Google treats it as a quality
// problem. A built 404.html makes Pages return a real 404 status on its own.
import Base from '../layouts/Base.astro';
---
<Base
  lang="en"
  title="Page not found — Life2Film"
  description="That page does not exist. Life2Film turns the videos already on your iPhone into a montage, entirely on the device."
  basePath="/404"
>
  <section class="wrap notfound">
    <h1>Page not found</h1>
    <p>
      That link does not lead anywhere. It may have moved, or it may never have existed.
    </p>
    <p>
      <a class="btn" href="/">Go to the home page</a>
    </p>
    <p class="alt">
      Looking for something specific? <a href="/about">About</a> ·
      <a href="/support">Support</a> · <a href="/blog">Blog</a> · <a href="/privacy">Privacy</a>
    </p>
  </section>
</Base>

<style>
  .notfound { padding: 6rem 0 8rem; max-width: 46rem; }
  .notfound h1 { margin: 0 0 1rem; }
  .notfound p { margin: 0 0 1.25rem; opacity: .85; }
  .notfound .alt { font-size: .95rem; opacity: .7; }
</style>
